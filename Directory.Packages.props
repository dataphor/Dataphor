<Project>

  <!-- Central package management: every PackageReference takes its version from this file. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Transitive pinning is off: nothing needs pinning yet; security-dependency-audit decides that later. -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- BenchmarkDotNet is used by one project, the benchmark program tests/Dataphor.Benchmarks, which nothing ships. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="CoreWCF.NetTcp" Version="1.9.1" />
    <PackageVersion Include="CoreWCF.Primitives" Version="1.9.1" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <!-- The native SQL Server network interface, which Microsoft.Data.SqlClient 7.1.2 depends on; one version per package id, so it tracks that client. -->
    <PackageVersion Include="Microsoft.Data.SqlClient.SNI.runtime" Version="7.1.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Newtonsoft.Json.Bson" Version="1.0.3" />
    <!--
      Npgsql: the PostgreSQL driver, private to libraries/PGSQLConnection; it replaced the checked-in Npgsql 2.0.4, and
      Mono.Security is gone with it (the driver has carried its own TLS since 3.x). Pinned to the 10.x line, the one built
      for the .NET 10 generation, and deliberately NOT to 11.0.0, which is the current release and also targets net10.0:
      11.0.0 depends on Microsoft.Extensions.Logging.Abstractions and System.Diagnostics.DiagnosticSource 11.0.0, higher
      versions of assemblies the shared frameworks provide at 10.0.0, and a flat library folder cannot load a different
      version of such an assembly - the driver throws FileLoadException the moment it builds a data source, before it
      connects to anything. Measured; the mechanism is the NOTE in tools/layout/Layout.csproj.
    -->
    <PackageVersion Include="Npgsql" Version="10.0.4" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="System.Data.Odbc" Version="10.0.15" />
    <PackageVersion Include="System.Data.OleDb" Version="10.0.15" />
    <PackageVersion Include="System.Data.SQLite.Core" Version="1.0.119" />
    <PackageVersion Include="System.ServiceModel.Http" Version="10.1.0" />
    <PackageVersion Include="System.ServiceModel.NetTcp" Version="10.1.0" />
    <PackageVersion Include="System.ServiceModel.Primitives" Version="10.1.0" />
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.15" />
  </ItemGroup>

</Project>
