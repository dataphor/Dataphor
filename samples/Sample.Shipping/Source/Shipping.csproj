<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Alphora.Shipping</AssemblyName>
    <RootNamespace>Shipping</RootNamespace>
    <OutputType>Library</OutputType>
    <!-- Coordinate.cs reads and writes its conveyor's buffer through fixed pointers, as in 3.1. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Constants: the legacy Release set without SIGNASSEMBLIES (signing is set in Directory.Build.props) in both configurations, plus DEBUG;TRACE in Debug as legacy Debug had them. Set outright; see Directory.Build.props. -->
  <PropertyGroup>
    <DefineConstants>TRACE</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\engine\Base\Base.csproj" />
    <ProjectReference Include="..\..\..\src\engine\DAE\DAE.csproj" />
    <ProjectReference Include="..\..\..\src\engine\Server\Server.csproj" />
    <ProjectReference Include="..\..\..\libraries\Connection\Source\DAE.Connection.csproj" />
    <ProjectReference Include="..\..\..\libraries\SQLDevice\Source\DAE.Device.SQL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Coordinate.cs" />
    <Compile Include="Domains.cs" />
    <Compile Include="Register.cs" />
  </ItemGroup>

</Project>
