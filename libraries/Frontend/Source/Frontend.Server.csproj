    <Compile Include="Production\DocumentBuilder.cs" />
    <Compile Include="Register.cs" />
    <Compile Include="Server.cs" />
    <Compile Include="ServerException.cs" />
    <Compile Include="Strings.cs" />
    <Compile Include="Structuring\Elements.cs" />
    <Compile Include="Structuring\LayoutBuilder.cs" />
    <Compile Include="Structuring\Nodes.cs" />
    <Compile Include="Structuring\StructureBuilder.cs" />
