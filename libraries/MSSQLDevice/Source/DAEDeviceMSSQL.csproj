<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RootNamespace is empty, as in 3.1, and must stay so: MSSQLDevice.cs loads its embedded scripts by the bare names
    SystemCatalog.d4 and SystemCatalog.sql. Left unset, the SDK would default it to the project name and rename them.
  -->
  <PropertyGroup>
    <AssemblyName>AlphoraMSSQLDevice</AssemblyName>
    <RootNamespace></RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!-- Constants: the legacy Release set without SIGNASSEMBLIES (signing is set in Directory.Build.props), which leaves none, in both configurations, plus DEBUG;TRACE in Debug. Set outright; see Directory.Build.props. -->
  <PropertyGroup>
    <DefineConstants></DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\engine\Base\Base.csproj" />
    <ProjectReference Include="..\..\..\src\engine\DAE\DAE.csproj" />
    <ProjectReference Include="..\..\..\src\engine\Server\Server.csproj" />
    <ProjectReference Include="..\..\Connection\Source\DAE.Connection.csproj" />
    <ProjectReference Include="..\..\SQLDevice\Source\DAE.Device.SQL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Device.MSSQL\MSSQLConnectionStringBuilder.cs" />
    <Compile Include="Device.MSSQL\MSSQLDevice.cs" />
    <Compile Include="Device.MSSQL\MSSQLInstructionNodes.cs" />
    <Compile Include="Device.MSSQL\MSSQLOperators.cs" />
    <Compile Include="Device.MSSQL\MSSQLTypes.cs" />
    <Compile Include="Device.MSSQL\Register.cs" />
    <Compile Include="Language.TSQL\Emitter.cs" />
    <Compile Include="Language.TSQL\Language.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="SystemCatalog.d4" />
    <EmbeddedResource Include="SystemCatalog.sql" />
  </ItemGroup>

</Project>
