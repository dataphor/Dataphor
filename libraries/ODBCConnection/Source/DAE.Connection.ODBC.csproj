<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Alphora.Dataphor.DAE.Connection.ODBC</AssemblyName>
    <RootNamespace>Alphora.Dataphor.DAE.Connection.ODBC</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!-- Constants: the legacy Release set without SIGNASSEMBLIES (signing is set in Directory.Build.props), which leaves none, in both configurations, plus DEBUG;TRACE in Debug. Set outright; see Directory.Build.props. -->
  <PropertyGroup>
    <DefineConstants></DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\engine\Base\Base.csproj" />
    <ProjectReference Include="..\..\..\src\engine\DAE\DAE.csproj" />
    <ProjectReference Include="..\..\..\src\engine\Server\Server.csproj" />
    <ProjectReference Include="..\..\Connection\Source\DAE.Connection.csproj" />
  </ItemGroup>

  <!-- System.Data.Odbc: ODBCConnection.cs. The package is private to this library (no project it references has it), so its runtime files land in the library folder; at run time it needs an ODBC driver manager on the machine. -->
  <ItemGroup>
    <PackageReference Include="System.Data.Odbc" />
  </ItemGroup>

  <!-- Default items are off (Directory.Build.props), so the compiled files are listed. -->
  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="ODBCConnection.cs" />
    <Compile Include="Register.cs" />
  </ItemGroup>

</Project>
