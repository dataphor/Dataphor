<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Alphora.Dataphor.DAE.Connection</AssemblyName>
    <RootNamespace>Alphora.Dataphor.DAE.Connection</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!-- Constants: the legacy Release set without SIGNASSEMBLIES (signing is set in Directory.Build.props), which leaves none, in both configurations, plus DEBUG;TRACE in Debug. Set outright; see Directory.Build.props. -->
  <PropertyGroup>
    <DefineConstants></DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <!-- 3.1 also referenced the SQL CE store project, for the Connection.SQLCEConnection class; SQL CE is gone (K19). -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\engine\Base\Base.csproj" />
    <ProjectReference Include="..\..\..\src\engine\DAE\DAE.csproj" />
    <ProjectReference Include="..\..\..\src\engine\Server\Server.csproj" />
  </ItemGroup>

  <!-- System.Data.OleDb: OLEDBConnection.cs (Windows only). System.Data.SqlClient: ClearAllPoolsNode in Operators.cs; it follows the SQL Server code to Microsoft.Data.SqlClient (device-mssql-port). -->
  <ItemGroup>
    <PackageReference Include="System.Data.OleDb" />
    <PackageReference Include="System.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="ConnectionStringBuilder.cs" />
    <Compile Include="OLEDBConnection.cs" />
    <Compile Include="Operators.cs" />
    <Compile Include="Register.cs" />
  </ItemGroup>

</Project>
