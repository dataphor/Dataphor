<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Alphora.Dataphor.DAE.Device.Simple</AssemblyName>
    <RootNamespace>DAE.Device.Simple</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!-- Constants: the legacy Release set without SIGNASSEMBLIES (signing is set in Directory.Build.props), which leaves none, in both configurations, plus DEBUG;TRACE in Debug. Set outright; see Directory.Build.props. -->
  <PropertyGroup>
    <DefineConstants></DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\engine\Base.Windows\Base.Windows.csproj" />
    <ProjectReference Include="..\..\..\src\engine\Base\Base.csproj" />
    <ProjectReference Include="..\..\..\src\engine\DAE\DAE.csproj" />
    <ProjectReference Include="..\..\..\src\engine\Server\Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Register.cs" />
    <Compile Include="SimpleDevice.cs" />
    <Compile Include="SimpleException.cs" />
  </ItemGroup>

  <!-- DependentUpon gives the resource the name of the first class in SimpleException.cs, Alphora.Dataphor.DAE.Device.Simple.SimpleDeviceException.resources, which that class loads; without it the name would follow the root namespace. -->
  <ItemGroup>
    <EmbeddedResource Include="SimpleException.resx">
      <DependentUpon>SimpleException.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

</Project>
