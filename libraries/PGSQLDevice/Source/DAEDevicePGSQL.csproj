<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RootNamespace is empty, as in 3.1, and must stay so: PostgreSQLDevice.cs loads its embedded scripts by the bare
    names SystemCatalog.d4 and SystemCatalog.sql. Left unset, the SDK would default it to the project name and rename
    them.
  -->
  <PropertyGroup>
    <AssemblyName>AlphoraPGSQLDevice</AssemblyName>
    <RootNamespace></RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!-- Constants: the legacy Release set without SIGNASSEMBLIES (signing is set in Directory.Build.props), which leaves none, in both configurations, plus DEBUG;TRACE in Debug. Set outright; see Directory.Build.props. -->
  <PropertyGroup>
    <DefineConstants></DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <!--
    DAE.Connection.PGSQL is referenced where the legacy project referenced nothing: the device names the connection
    class "PostgreSQLConnection.PostgreSQLConnection" as a string, which the server resolves through the registered
    library rather than through a compile-time reference, so 3.1 built without it. The reference is here so that
    building this project builds the connection library too and the layout gets both; nothing in this assembly binds
    to a type in it.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\engine\Base\Base.csproj" />
    <ProjectReference Include="..\..\..\src\engine\DAE\DAE.csproj" />
    <ProjectReference Include="..\..\..\src\engine\Server\Server.csproj" />
    <ProjectReference Include="..\..\Connection\Source\DAE.Connection.csproj" />
    <ProjectReference Include="..\..\SQLDevice\Source\DAE.Device.SQL.csproj" />
    <ProjectReference Include="..\..\PGSQLConnection\Source\DAE.Connection.PGSQL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Device.PGSQL\PostgreSQLDeviceSession.cs" />
    <Compile Include="Device.PGSQL\PostgreSQLConnectionStringBuilder.cs" />
    <Compile Include="Device.PGSQL\PostgreSQLDevice.cs" />
    <Compile Include="Device.PGSQL\PostgreSQLInstructionNodes.cs" />
    <Compile Include="Device.PGSQL\PostgreSQLOperators.cs" />
    <Compile Include="Device.PGSQL\PostgreSQLTypes.cs" />
    <Compile Include="Device.PGSQL\Register.cs" />
    <Compile Include="Language.PGSQL\Emitter.cs" />
    <Compile Include="Language.PGSQL\Language.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="SystemCatalog.d4" />
    <EmbeddedResource Include="SystemCatalog.sql" />
  </ItemGroup>

</Project>
