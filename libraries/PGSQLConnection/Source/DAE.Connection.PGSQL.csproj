<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Alphora.Dataphor.DAE.Connection.PGSQL</AssemblyName>
    <RootNamespace>Alphora.Dataphor.DAE.Connection.PGSQL</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!-- Constants: the legacy Release set without SIGNASSEMBLIES (signing is set in Directory.Build.props) in both configurations, plus DEBUG;TRACE in Debug. Set outright; see Directory.Build.props. -->
  <PropertyGroup>
    <DefineConstants>TRACE</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\engine\Base\Base.csproj" />
    <ProjectReference Include="..\..\..\src\engine\DAE\DAE.csproj" />
    <ProjectReference Include="..\..\..\src\engine\Server\Server.csproj" />
    <!--
      PrivateAssets, where no other library project needs it: this library's D4 descriptor requires the library Connection
      (PGSQLConnection.d4l), and the reference keeps that pairing and the build order the runtime layout relies on - but
      nothing here compiles against that assembly, and its OLE DB and ODBC packages must not reach a consumer of this
      project. The catalog store src\engine\Store.PGSQL is such a consumer and is in the layout's Bin list, where every
      package file of its closure lands in bin\ beside the engine's own: System.Data.OleDb asks for
      System.Configuration.ConfigurationManager 10.0.15 and Microsoft.Data.SqlClient 7.1.2 for 9.0.21, and bin\ holds one
      file per name, so without this the layout fails with "Two different files would be copied to ...".
    -->
    <ProjectReference Include="..\..\Connection\Source\DAE.Connection.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Npgsql: PostgreSQLConnection.cs and PostgreSQLCommand.cs. 3.1 compiled against the checked-in Npgsql 2.0.4 and
    Mono.Security 2.0; the driver has carried its own TLS since 3.x, so nothing references Mono.Security any more.
    The package is private to this library (no project it references has it), so its runtime file lands flat in the
    library folder - Npgsql.dll alone: the two Microsoft.Extensions abstractions it depends on are the versions the
    host's shared frameworks provide, so conflict resolution leaves them out and the framework's copies load. The
    version pin in Directory.Packages.props says why that has to stay true. At run time the driver opens a connection
    only when a device or a catalog store asks it to, so registering the library needs no PostgreSQL server.
  -->
  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <!-- Default items are off (Directory.Build.props), so the compiled files are listed. -->
  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="PostgreSQLCommand.cs" />
    <Compile Include="PostgreSQLConnection.cs" />
    <Compile Include="Register.cs" />
  </ItemGroup>

</Project>
