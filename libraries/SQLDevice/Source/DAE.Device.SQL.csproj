<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Alphora.Dataphor.DAE.Device.SQL</AssemblyName>
    <RootNamespace>Alphora.Dataphor.DAE.Device.SQL</RootNamespace>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Constants: the legacy Release set without SIGNASSEMBLIES (signing comes with build-version-and-signing) in both configurations, plus DEBUG;TRACE in Debug. Legacy Debug also had USEVISIT, which 3.1 did not ship with (see DAE.csproj). Set outright; see Directory.Build.props. -->
  <PropertyGroup>
    <DefineConstants></DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\engine\Base\Base.csproj" />
    <ProjectReference Include="..\..\..\src\engine\DAE\DAE.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Register.cs" />
    <Compile Include="SQLDateTimeOperators.cs" />
    <Compile Include="SQLDevice.cs" />
    <Compile Include="SQLDeviceCursor.cs" />
    <Compile Include="SQLException.cs" />
    <Compile Include="SQLOperators.cs" />
    <Compile Include="SQLTypes.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="SQLException.resx" />
  </ItemGroup>

</Project>
