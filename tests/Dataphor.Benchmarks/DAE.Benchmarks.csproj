<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The benchmark program (plan WS3). It measures the three costs the timing scripts in tests/DAE.Server.Tests cannot
    reach from inside an already-running server: how long an engine takes to come up, a representative mix of database
    work on the in-memory device, and the catalog store cold and warm. docs/perf-baseline.md carries its numbers and
    README.md says how to run it.

    It follows tests/TestHarness/DAE.Test.Harness.csproj: a program under tests/ that is listed in Dataphor.slnx, so
    that dotnet build Dataphor.slnx and CI compile and type-check it, and is deliberately absent from
    tools/layout/Layout.csproj because nothing ships it. It is not a test project - no Microsoft.NET.Test.Sdk and no
    NUnit - so dotnet test neither discovers nor runs it; IsTestProject is set outright so that stays true however the
    SDK's defaults change. Run it by hand, in Release.
  -->
  <PropertyGroup>
    <AssemblyName>DAE.Benchmarks</AssemblyName>
    <RootNamespace>DAE.Benchmarks</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <!-- Constants: the same set as the test project whose numbers this program extends (TRACE in both configurations, plus DEBUG in Debug). Set outright; see Directory.Build.props. -->
  <PropertyGroup>
    <DefineConstants>TRACE</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\engine\DAE\DAE.csproj" />
    <ProjectReference Include="..\..\src\engine\Server\Server.csproj" />
    <!--
      Not compiled against, and not optional: the server resolves its catalog store from a class name with
      Type.GetType, and on .NET 10 an assembly that sits next to the executable but is not named in the executable's
      .deps.json cannot be loaded by simple name. Without this reference a server started here fails with error 115107.
      tests/TestHarness/DAE.Test.Harness.csproj carries the same reference for the same reason.
    -->
    <ProjectReference Include="..\..\src\engine\Store.SQLite\DAE.SQLite.csproj" />
    <!-- Builds the runtime layout before this project, so that a benchmark never measures against a stale or missing layout. Nothing is compiled against it or copied from it, as in tests/DAE.Server.Tests. -->
    <ProjectReference Include="..\..\tools\layout\Layout.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!--
    CoreWCF.NetTcp and the framework reference: this program gets CoreWCF.NetTcp through its reference to Server, and a
    project that gets it only that way reports the package-audit warning NU1902 for its Microsoft.AspNetCore.* 2.3.10
    dependencies. Declaring the package here as well lets NuGet's package-override mechanism substitute the in-box
    ASP.NET Core 10 assemblies; Server.Hosting.csproj records the measurement. This program therefore needs the
    ASP.NET Core shared runtime as well as the .NET one, which every .NET SDK install provides. It hosts nothing: the
    servers it starts are in-process and listen on no port.
  -->
  <ItemGroup>
    <PackageReference Include="CoreWCF.NetTcp" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="BenchmarkServerInstance.cs" />
    <Compile Include="EngineBenchmarks.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <!--
    The runtime layout of the configuration being built, which BenchmarkServerInstance reads at run time, and the
    build output root, under which BenchmarkDotNet writes its own artifacts (artifacts/ is git-ignored, so its export
    and logs leave nothing in the tree). Never spell either path in code; tests/DAE.Server.Tests records the first the
    same way. Items see the two properties, which Directory.Build.targets and Directory.Build.props define, because
    MSBuild evaluates every property before any item. The assembly embeds absolute build-machine paths, which is
    acceptable in a program that never ships.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="DataphorLayoutDir" Value="$(DataphorLayoutDir)" />
    <AssemblyMetadata Include="DataphorArtifactsDir" Value="$(ArtifactsPath)" />
  </ItemGroup>

</Project>
