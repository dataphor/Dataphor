<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>DAE.Server.Tests</AssemblyName>
    <RootNamespace>Alphora.Dataphor.DAE.Server.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Constants: the legacy Release set (TRACE) in both configurations, plus DEBUG;TRACE in Debug as legacy Debug had them. Set outright; see Directory.Build.props. -->
  <PropertyGroup>
    <DefineConstants>TRACE</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ApplicationTransactionTest.cs" />
    <Compile Include="CatalogStoreTest.cs" />
    <Compile Include="CatalogStoreConcurrencyTest.cs" />
    <Compile Include="ConcurrentDDLTest.cs" />
    <Compile Include="ContractParityTest.cs" />
    <Compile Include="CoreWcfProtocolTest.cs" />
    <Compile Include="CoverageManifest.cs" />
    <Compile Include="CoverageScripts.cs" />
    <Compile Include="CursorTest.cs" />
    <Compile Include="D4EmitterRoundTripTest.cs" />
    <Compile Include="DeferredDeviceStopTest.cs" />
    <Compile Include="InProcessTestFixture.cs" />
    <Compile Include="InstanceConfigurationTest.cs" />
    <Compile Include="InternalCoverageTests.cs" />
    <Compile Include="LibraryLoadingTest.cs" />
    <Compile Include="MemoryDeviceConcurrencyTest.cs" />
    <Compile Include="ParserRoundTripCorpusTest.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="SchemaCacheInvalidationTest.cs" />
    <Compile Include="StoreContractTests.cs" />
    <Compile Include="StoreRebuildWorkflowTest.cs" />
    <Compile Include="TestEnvironment.cs" />
    <Compile Include="TestServerInstance.cs" />
    <Compile Include="TransactionBeginTest.cs" />
  </ItemGroup>

  <!-- The coverage manifest (see CoverageManifest.cs), read from the assembly so that an edit to it rebuilds the tests and nothing reads a stale copy. -->
  <ItemGroup>
    <EmbeddedResource Include="coverage-manifest.json" LogicalName="coverage-manifest.json" />
  </ItemGroup>

  <!--
    CoreWCF.NetTcp and the framework reference: this project references Server.Hosting, which carries both, and a
    project that gets CoreWCF.NetTcp only through a project reference reports the package-audit warning NU1902 for
    its Microsoft.AspNetCore.* 2.3.10 dependencies. Declaring the package here as well lets NuGet's package-override
    mechanism substitute the in-box ASP.NET Core 10 assemblies; Server.Hosting.csproj records the measurement.
    Running this suite therefore needs the ASP.NET Core shared runtime as well as the .NET one, which every .NET SDK
    install provides.
  -->
  <ItemGroup>
    <PackageReference Include="CoreWCF.NetTcp" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\engine\DAE\DAE.csproj" />
    <ProjectReference Include="..\..\src\engine\Server\Server.csproj" />
    <!-- The real host the protocol tests drive (protocol-corewcf-host); it also brings CoreWCF.NetTcp in. -->
    <ProjectReference Include="..\..\src\engine\Server.Hosting\Server.Hosting.csproj" />
    <!-- The client's copies of the three service contracts, which ContractParityTest compares with the server's. Both are named explicitly, although the server reference already brings the NativeCLI one in, because this project compiles against them. -->
    <ProjectReference Include="..\..\src\protocol\Client\Client.csproj" />
    <ProjectReference Include="..\..\src\protocol\NativeCLI\DAE.NativeCLI.csproj" />
    <!-- Not compiled against: the server loads the catalog store by class name, so the assembly only has to be in the test's output. -->
    <ProjectReference Include="..\..\src\engine\Store.SQLite\DAE.SQLite.csproj" />
    <!-- Builds the runtime layout before this project, so that dotnet test and Visual Studio never run the tests against a stale or missing layout. Nothing is compiled against it or copied from it. -->
    <ProjectReference Include="..\..\tools\layout\Layout.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!--
    The runtime layout of the configuration being built, which TestEnvironment reads at run time; never spell the path in code.
    An item sees DataphorLayoutDir, which Directory.Build.targets defines, because MSBuild evaluates every property before any item.
    The assembly embeds an absolute build-machine path, so it is not identical across machines; it is a test assembly and never ships.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="DataphorLayoutDir" Value="$(DataphorLayoutDir)" />
  </ItemGroup>

</Project>
