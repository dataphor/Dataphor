<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>DAE.Server.Tests</AssemblyName>
    <RootNamespace>Alphora.Dataphor.DAE.Server.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Constants: the legacy Release set (TRACE) in both configurations, plus DEBUG;TRACE in Debug as legacy Debug had them. Set outright; see Directory.Build.props. -->
  <PropertyGroup>
    <DefineConstants>TRACE</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="CatalogStoreTest.cs" />
    <Compile Include="CoverageManifest.cs" />
    <Compile Include="CoverageScripts.cs" />
    <Compile Include="CursorTest.cs" />
    <Compile Include="InProcessTestFixture.cs" />
    <Compile Include="InternalCoverageTests.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="TestEnvironment.cs" />
    <Compile Include="TestServerInstance.cs" />
  </ItemGroup>

  <!-- The coverage manifest (see CoverageManifest.cs), read from the assembly so that an edit to it rebuilds the tests and nothing reads a stale copy. -->
  <ItemGroup>
    <EmbeddedResource Include="coverage-manifest.json" LogicalName="coverage-manifest.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\engine\DAE\DAE.csproj" />
    <ProjectReference Include="..\..\src\engine\Server\Server.csproj" />
    <!-- Not compiled against: the server loads the catalog store by class name, so the assembly only has to be in the test's output. -->
    <ProjectReference Include="..\..\src\engine\Store.SQLite\DAE.SQLite.csproj" />
    <!-- Builds the runtime layout before this project, so that dotnet test and Visual Studio never run the tests against a stale or missing layout. Nothing is compiled against it or copied from it. -->
    <ProjectReference Include="..\..\tools\layout\Layout.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!--
    The runtime layout of the configuration being built, which TestEnvironment reads at run time; never spell the path in code.
    An item sees DataphorLayoutDir, which Directory.Build.targets defines, because MSBuild evaluates every property before any item.
    The assembly embeds an absolute build-machine path, so it is not identical across machines; it is a test assembly and never ships.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="DataphorLayoutDir" Value="$(DataphorLayoutDir)" />
  </ItemGroup>

</Project>
