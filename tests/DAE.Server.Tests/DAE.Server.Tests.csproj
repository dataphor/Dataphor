<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>DAE.Server.Tests</AssemblyName>
    <RootNamespace>Alphora.Dataphor.DAE.Server.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Constants: the legacy Release set (TRACE) in both configurations, plus DEBUG;TRACE in Debug as legacy Debug had them. Set outright; see Directory.Build.props. -->
  <PropertyGroup>
    <DefineConstants>TRACE</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AbandonedClientProcessTest.cs" />
    <Compile Include="AbandonedSessionCleanupTest.cs" />
    <Compile Include="ApplicationTransactionTest.cs" />
    <Compile Include="CatalogStoreTest.cs" />
    <Compile Include="CatalogStoreConcurrencyTest.cs" />
    <Compile Include="ConcurrentDDLTest.cs" />
    <Compile Include="ConnectionKeepAliveTest.cs" />
    <Compile Include="ConnectionSecurityModeTest.cs" />
    <Compile Include="ContractParityTest.cs" />
    <Compile Include="CorpusLibrary.cs" />
    <Compile Include="CoreWcfProtocolTest.cs" />
    <Compile Include="CoverageManifest.cs" />
    <Compile Include="CoverageScripts.cs" />
    <Compile Include="CursorTest.cs" />
    <Compile Include="D4EmitterRoundTripTest.cs" />
    <Compile Include="DeferredDeviceStopTest.cs" />
    <Compile Include="FormCustomizationTest.cs" />
    <Compile Include="FormDocumentCorpusTest.cs" />
    <Compile Include="FrontendDerivationGoldenTest.cs" />
    <Compile Include="FrontendFixture.cs" />
    <Compile Include="HostBindingHookTest.cs" />
    <Compile Include="HostCommandLineTest.cs" />
    <Compile Include="HostProgramTest.cs" />
    <Compile Include="HostedInstance.cs" />
    <Compile Include="InProcessTestFixture.cs" />
    <Compile Include="InstanceConfigurationTest.cs" />
    <Compile Include="InstanceManagerTest.cs" />
    <Compile Include="InternalCoverageTests.cs" />
    <Compile Include="LibraryLoadingTest.cs" />
    <Compile Include="MemoryDeviceConcurrencyTest.cs" />
    <Compile Include="ObjectIDGeneratorTest.cs" />
    <Compile Include="OutOfProcessInstance.cs" />
    <Compile Include="OutOfProcessProtocolTest.cs" />
    <Compile Include="ParserRoundTripCorpusTest.cs" />
    <Compile Include="PerfBaselineTest.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="ProtocolClient.cs" />
    <Compile Include="QuotaDeleteCostTest.cs" />
    <Compile Include="SamplesCorpusTest.cs" />
    <Compile Include="SchemaCacheInvalidationTest.cs" />
    <Compile Include="ServerLinkConnectionTest.cs" />
    <Compile Include="ServerLinkUserRollbackTest.cs" />
    <Compile Include="ServiceUtilityTest.cs" />
    <Compile Include="StoreContractTests.cs" />
    <Compile Include="StoreRebuildWorkflowTest.cs" />
    <Compile Include="TableAssignmentEvaluationTest.cs" />
    <Compile Include="TestEnvironment.cs" />
    <Compile Include="TestServerInstance.cs" />
    <Compile Include="TransactionBeginTest.cs" />
  </ItemGroup>

  <!-- The coverage manifest (see CoverageManifest.cs), read from the assembly so that an edit to it rebuilds the tests and nothing reads a stale copy. -->
  <ItemGroup>
    <EmbeddedResource Include="coverage-manifest.json" LogicalName="coverage-manifest.json" />
  </ItemGroup>

  <!--
    CoreWCF.NetTcp and the framework reference: this project references Server.Hosting, which carries both, and a
    project that gets CoreWCF.NetTcp only through a project reference reports the package-audit warning NU1902 for
    its Microsoft.AspNetCore.* 2.3.10 dependencies. Declaring the package here as well lets NuGet's package-override
    mechanism substitute the in-box ASP.NET Core 10 assemblies; Server.Hosting.csproj records the measurement.
    Running this suite therefore needs the ASP.NET Core shared runtime as well as the .NET one, which every .NET SDK
    install provides.
  -->
  <ItemGroup>
    <PackageReference Include="CoreWCF.NetTcp" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\engine\DAE\DAE.csproj" />
    <ProjectReference Include="..\..\src\engine\Server\Server.csproj" />
    <!-- The real host the protocol tests drive (protocol-corewcf-host); it also brings CoreWCF.NetTcp in. -->
    <ProjectReference Include="..\..\src\engine\Server.Hosting\Server.Hosting.csproj" />
    <!-- ServiceUtility, whose catch-and-return-a-default behaviour ServiceUtilityTest pins. -->
    <ProjectReference Include="..\..\src\hosts\Host\DAE.Host.csproj" />
    <!-- The client's copies of the three service contracts, which ContractParityTest compares with the server's. Both are named explicitly, although the server reference already brings the NativeCLI one in, because this project compiles against them. -->
    <ProjectReference Include="..\..\src\protocol\Client\Client.csproj" />
    <ProjectReference Include="..\..\src\protocol\NativeCLI\DAE.NativeCLI.csproj" />
    <!-- The catalog stores the store contract is run against (StoreContractTests), one fixture per store. -->
    <ProjectReference Include="..\..\src\engine\Store.MSSQL\DAE.MSSQL.csproj" />
    <ProjectReference Include="..\..\src\engine\Store.SQLite\DAE.SQLite.csproj" />
    <!-- Builds the runtime layout before this project, so that dotnet test and Visual Studio never run the tests against a stale or missing layout. Nothing is compiled against it or copied from it. -->
    <ProjectReference Include="..\..\tools\layout\Layout.csproj" ReferenceOutputAssembly="false" Private="false" />
    <!-- The test server program the out-of-process fixtures start as a child process; built before this project, not compiled against and not copied here (the target below records its path instead). -->
    <ProjectReference Include="..\TestHarness\DAE.Test.Harness.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!--
    The runtime layout of the configuration being built, which TestEnvironment reads at run time; never spell the path in code.
    An item sees DataphorLayoutDir, which Directory.Build.targets defines, because MSBuild evaluates every property before any item.
    The assembly embeds an absolute build-machine path, so it is not identical across machines; it is a test assembly and never ships.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="DataphorLayoutDir" Value="$(DataphorLayoutDir)" />
  </ItemGroup>

  <!--
    The repository root, which the corpus tests read source files from (the layout holds only what the build assembles,
    so a test that must see every file in the tree reads the tree). Normalized here rather than in code, so that nothing
    spells the path; like the layout path it is an absolute build-machine path in a test assembly that never ships.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="DataphorRepositoryDir" Value="$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..'))" />
  </ItemGroup>

  <!--
    The checked-in golden files (tests/goldens), which FrontendDerivationGoldenTest compares derived forms against and,
    with DATAPHOR_UPDATE_FRONTEND_GOLDENS=1, writes. Deliberately above this project rather than inside it, so that the
    other passes which compare generated output against a reviewed file keep their trees beside this one; like the two
    paths above it is an absolute build-machine path in a test assembly that never ships.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="DataphorGoldensDir" Value="$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', 'goldens'))" />
  </ItemGroup>

  <!--
    The test server program, which OutOfProcessInstance starts as a child process and whose path code must never spell.
    Asked of that project rather than composed from $(ArtifactsPath), so that a change to the output layout cannot
    leave this pointing at nothing; GetTargetPath returns the assembly, and the program is the application host beside
    it (TestEnvironment.FindTestHarnessPath changes the extension). Before GetAssemblyAttributes, which is where the
    SDK turns AssemblyMetadata items into attributes.
  -->
  <Target Name="_DataphorRecordTestHarnessPath" BeforeTargets="GetAssemblyAttributes">
    <MSBuild Projects="..\TestHarness\DAE.Test.Harness.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_DataphorTestHarnessTargetPath" />
    </MSBuild>
    <ItemGroup>
      <AssemblyMetadata Include="DataphorTestHarnessPath" Value="@(_DataphorTestHarnessTargetPath)" />
    </ItemGroup>
  </Target>

</Project>
