// TODO: coverage for the System.Internet library

select URLEncode('Oh what a happy day Steeeempy!  You & I');
select URLDecode(URLEncode('Oh what a happy day Steeeempy!  You & I'));
select HTMLEncode('Oh what a happy day Steeeempy!  You & I <are gunna shine>!');
select HTMLDecode(HTMLEncode('Oh what a happy day Steeeempy!  You & I <are gunna shine>!'));
select HTMLAttributeEncode('And I say & quote, "the world couldn''t seem any <stranger>"');
select HTMLDecode(HTMLAttributeEncode('And I say & quote, "the world couldn''t seem any <stranger>"'));

// JSON nesting depth. Newtonsoft.Json 13 refuses to read JSON nested more than 64 levels deep;
// version 9, which 3.1 shipped, had no limit. Measured against 13.0.4; see docs/migration-notes.md.
// NOTE: the assertions below match Newtonsoft's own message text; an upgrade that moves the limit or
// rewords the message breaks them on purpose - re-measure against the new version (debt-library-upgrades-coverage).
// All three reader sites in DynamicNodes.cs are asserted below. The library's fourth JSON reader, in
// JSONObjectConveyor.cs, is not reachable from a D4 script: it renders a value for storage or for the wire,
// and a Dynamic column can only live in the memory device, which never asks for that. It is covered by
// JSONObjectConveyorTest in tests/DAE.Server.Tests, which drives the engine path directly.
begin
	var LMaxDepthError : String := 'MaxDepth of 64 has been exceeded';
	var LOpen : String := '';
	var LClose : String := '';
	var LIndex : Integer := 0;
	while LIndex < 64 do
	begin
		LOpen := LOpen + '{"a":';
		LClose := LClose + '}';
		LIndex := LIndex + 1;
	end;
	var LAt64 : String := LOpen + '1' + LClose;
	var LAt65 : String := LOpen + '{"a":1}' + LClose;

	// 64 levels read
	if GetType(Dynamic(LAt64)) <> 'Object' then
		raise Error('Dynamic did not read 64 levels of nesting');

	// 65 levels are refused by the string selector
	var LCaught : String := '';
	try
		var LTooDeep : Dynamic := Dynamic(LAt65);
	except on E : Error do
		LCaught := E.Message;
	end;
	if IndexOf(LCaught, LMaxDepthError) < 0 then
		raise Error('Dynamic read 65 levels of nesting, or failed with an unexpected error: ' + LCaught);

	// and by the Content write accessor
	LCaught := '';
	try
		var LValue : Dynamic := Dynamic('{"a":1}');
		LValue.Content := LAt65;
	except on E : Error do
		LCaught := E.Message;
	end;
	if IndexOf(LCaught, LMaxDepthError) < 0 then
		raise Error('The Content write accessor read 65 levels of nesting, or failed with an unexpected error: ' + LCaught);

	// and by the Content representation selector, which a row-valued call reaches. Measured: 64 levels
	// read through this site and 65 do not, so it is a reader of its own and not the Dynamic(String) operator.
	LCaught := '';
	try
		var LFromRow : Dynamic := Dynamic(row { LAt65 Content });
	except on E : Error do
		LCaught := E.Message;
	end;
	if IndexOf(LCaught, LMaxDepthError) < 0 then
		raise Error('The Content representation selector read 65 levels of nesting, or failed with an unexpected error: ' + LCaught);

	// Writing has no limit, so a value the engine builds itself can be deeper than it can read back.
	var LDeep : Dynamic := Dynamic('{"a":1}');
	LIndex := 0;
	while LIndex < 70 do
	begin
		LDeep := Set(Dynamic('{}'), 'a', LDeep);
		LIndex := LIndex + 1;
	end;
	var LDeepContent : String := LDeep.Content;
	LCaught := '';
	try
		var LRead : Dynamic := Dynamic(LDeepContent);
	except on E : Error do
		LCaught := E.Message;
	end;
	if IndexOf(LCaught, LMaxDepthError) < 0 then
		raise Error('A 71 level value serialized and read back, or failed with an unexpected error: ' + LCaught);
end;
