// Generated equality for a scalar type with one multi-property representation and no "=" of its own
// (System.CompoundScalarEqualNode): equal values compare true, values differing in any one property compare false.
create type CompoundPoint
{
	representation CompoundPoint { X : Integer, Y : Integer }
};

if not(CompoundPoint(1, 2) = CompoundPoint(1, 2)) then
	raise Error("Equal compound values compared unequal");

if CompoundPoint(1, 2) = CompoundPoint(1, 3) then
	raise Error("Compound values differing in the second property compared equal");

if CompoundPoint(1, 2) = CompoundPoint(0, 2) then
	raise Error("Compound values differing in the first property compared equal");

if not(CompoundPoint(1, 2) <> CompoundPoint(2, 1)) then
	raise Error("Unequal compound values failed <>");

drop type CompoundPoint;
