/*
	Stream-Backed Values

	Binary and Graphic are the two D4 types the engine does not carry inline: a value of either lives in a stream the
	server owns, and the server counts the holders of each stream so that it can give one back once its last holder is
	done with it. This script puts such values through what an application does with them - select one, read it back,
	copy it, write through the copy, write through the original, compare two, hold one across a rolled-back transaction
	- and asserts after each that the server is holding no stream it should not be.

	Diagnostics.StreamCount() is the instrument: the number of managed streams the server is holding, which is 0 in a
	server with nothing running. It is also the whole of the D4-visible surface. The engine has a
	SystemStreamsOpenNode, but SystemCatalog.d4 registers no operator over it, and adding one would be a change to the
	system catalog, which is a compatibility surface.

	What holds a stream, and what does not. Measured on 2026-11-23 and again on 2026-11-24, and re-asserted by the
	cases below, because it is not what one would guess:

		- a Binary or Graphic variable with a value holds one stream; one holding nil holds none
		- a variable initialised from another holds a second stream, which references the first rather than copying
		  its bytes
		- a list of Binary or Graphic holds one stream per element, and gives all of them back when it goes out of
		  scope; so does a list of rows with such a column, a row with a list column and a list of lists
		- reading a Binary or Graphic *table column* back into a variable takes out no stream of its own, and a stored
		  value is not changed by a later write through the variable it was inserted from. Variables are where the
		  sharing and the release happen, which is why most cases below are written over variables rather than rows.
		- a write of a stream-backed value into a table column costs no stream once the statement that made it has
		  finished. While a transaction is open the device session's undo log holds one managed stream per logged write -
		  one for an insert, one for an update, none for a delete - and gives all of them back when that transaction
		  commits or rolls back. An ordinary statement is its own transaction, so an ordinary insert, update or delete is
		  balanced; only a transaction a caller deliberately holds open accumulates, and it too gives everything back
		  when it ends. The top-level section after the row section asserts this.

	Counts and read-back values are what is asserted on, never stream identifiers: an identifier is allocation order,
	so a script that asserted on one would break the moment an earlier statement allocated one more stream. Each case
	records the count it starts from rather than assuming 0, so that the script still says something true if the
	coverage template ever registers something that holds a stream of its own.

	StreamAllocation.d4 is the 2004 script this one answers - All.Coverage.d4 still carries its "// TODO: Doesn't run
	1/17/2004" line - and it is left exactly as it is: it loads documents out of a Coverage library the coverage
	template does not register, and test-pre-3-1-scripts-policy owns its fate. Its three siblings cannot be answered
	this way at all: Diagnostics.LockCount(), RowCount() and UsedRowCount() all return a hard-coded 0 today, because
	the lock manager and row manager the 3.1 engine had are gone, so LockAllocation, RowAllocation and ScalarAllocation
	have no instrument to assert against.
*/

// The count the whole script is measured against, asserted at the very end once every block has gone out of scope.
var LScriptStart : Integer := StreamCount();

// The values the cases are built from, as base-64: that is what the Binary and Graphic selectors take and what their
// Value representation gives back.

// Four bytes - AA BB CC DD.
var LFour : String := 'qrvM3Q==';

// Eight bytes - 00 11 22 33 44 55 66 77 - twice the length of LFour and nothing like it, so a write of one over the
// other cannot read back right by accident, and a surviving tail of the longer one is unmistakable.
var LEight : String := 'ABEiM0RVZnc=';

// Eighteen bytes - 00 01 .. 11 - and, being a whole number of three-byte groups, carrying no base-64 padding. That is
// what lets it be concatenated with itself to build a larger value: padding is only valid at the end of a value.
var LFragment : String := 'AAECAwQFBgcICQoLDA0ODxAR';

// The same eighteen bytes with the last one changed from 11 to 12, for the large value that must compare unequal.
var LFragmentLastByteChanged : String := 'AAECAwQFBgcICQoLDA0ODxAS';

// 1200 fragments of 18 bytes make 21,600 bytes: large enough to be worth streaming and to be read in more than one
// buffer, small enough that building it by string concatenation in D4 costs well under a second. Keep it in that range
// rather than reaching for megabytes - the coverage run's wall clock is shared with every other script.
// NOTE: the loop below concatenates onto one growing string, so the cost of building these values is quadratic in the
// fragment count; the whole script runs in about 2 s today. If a larger value is ever wanted here, build it by doubling
// (LLarge := LLarge + LLarge) rather than by raising this count.
var LLargeFragments : Integer := 1200;

// 200 fragments make 3,600 bytes, the middle size.
var LMediumFragments : Integer := 200;

var LLarge : String := '';
var LLargeLastByteChanged : String := '';
var LMedium : String := '';

// The two large values are built from one loop so that they cannot drift apart anywhere but in that last fragment.
begin
	for LIndex : Integer := 1 to LLargeFragments - 1 do
		LLarge := LLarge + LFragment;
	LLargeLastByteChanged := LLarge + LFragmentLastByteChanged;
	LLarge := LLarge + LFragment;

	for LIndex : Integer := 1 to LMediumFragments do
		LMedium := LMedium + LFragment;
end;

/*
	Round trip, at four sizes - 4, 8, 3,600 and 21,600 bytes. A value put into a variable reads back as itself through
	both the Value representation and ToBase64String, and Length reports the byte count it was given.

	Length is asserted as well as the base-64, and not for symmetry: a stream read that stopped early would give a
	shorter value rather than an error, and ToBase64String alone could miss that if the prefix it did read was all the
	assertion compared. The range of sizes is here to catch a path that only runs for one of them; 4 and 8 bytes are
	both in it because they are also the pair the copy-on-write cases below write one over the other.
*/
create operator TestBinaryValue(const AValue : String, const AByteCount : Integer)
begin
	var LBefore : Integer := StreamCount();
	begin
		var LB : Binary := Binary(AValue);
		if StreamCount() <> LBefore + 1 then
			raise Error('A Binary variable of ' + ToString(AByteCount) + ' byte(s) took out ' + ToString(StreamCount() - LBefore) + ' stream(s) rather than one.');
		if LB.Value <> AValue then
			raise Error('A Binary of ' + ToString(AByteCount) + ' byte(s) did not read back through Value as the value selected.');
		if ToBase64String(LB) <> AValue then
			raise Error('A Binary of ' + ToString(AByteCount) + ' byte(s) did not read back through ToBase64String as the value selected.');
		if Length(LB) <> ToLong(AByteCount) then
			raise Error('A Binary of ' + ToString(AByteCount) + ' byte(s) reported a length of ' + ToString(Length(LB)) + '.');
	end;
	if StreamCount() <> LBefore then
		raise Error('A Binary of ' + ToString(AByteCount) + ' byte(s) left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

TestBinaryValue(LFour, 4);
TestBinaryValue(LEight, 8);
TestBinaryValue(LMedium, LMediumFragments * 18);
TestBinaryValue(LLarge, LLargeFragments * 18);

// Sharing. A variable initialised from another takes out a second stream, which references the first rather than
// copying its bytes (DataValue.CopyValue turns a stream identifier into a StreamManager.Reference), and the two
// compare equal.
// Every value comparison below is written "not(A = B)" rather than "A <> B", and that is deliberate rather than
// stylistic: a server with SQLDevice registered but MSSQLDevice unregistered cannot compile "<>" over two Binary
// values at all - it resolves to the iNotEqual(MSSQLBinary, MSSQLBinary) that SQLDevice's Register.d4 declares over a
// class in the MSSQLDevice assembly, and raises "Class alias not found" at run time. That is
// bug-binary-comparison-needs-the-mssql-device, met while writing this script; "=" is unaffected, because
// iEqual(Binary, Binary) is an exact match in the system catalog.
begin
	var LBefore : Integer := StreamCount();
	begin
		var LB : Binary := Binary(LEight);
		var LCopy : Binary := LB;
		if StreamCount() <> LBefore + 2 then
			raise Error('A Binary and a copy of it held ' + ToString(StreamCount() - LBefore) + ' stream(s) rather than two.');
		if not(LCopy = LB) then
			raise Error('A copy of a Binary did not compare equal to it.');
		if LCopy.Value <> LEight then
			raise Error('A copy of a Binary did not read back as the value it was taken from.');
	end;
	if StreamCount() <> LBefore then
		raise Error('A Binary and a copy of it left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

// Three distinct values held at once, so that the count is shown to be per value rather than per type or per scope.
begin
	var LBefore : Integer := StreamCount();
	begin
		var LOne : Binary := Binary(LFour);
		var LTwo : Binary := Binary(LEight);
		var LThree : Binary := Binary(LFragment);
		if StreamCount() <> LBefore + 3 then
			raise Error('Three Binary variables held ' + ToString(StreamCount() - LBefore) + ' stream(s) rather than three.');
		if (LOne = LTwo) or (LTwo = LThree) or (LOne = LThree) then
			raise Error('Three Binary variables with distinct values did not compare unequal.');
	end;
	if StreamCount() <> LBefore then
		raise Error('Three Binary variables left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

/*
	Copy-on-write, through the copy. Writing a copy's Value gives that copy contents of its own: the copy reads back
	what was written, the variable it was taken from still reads what it had, and the count does not move. The count
	staying put is not an oversight in the assertion - separating a copy gives it a stream in the provider but no new
	header, and StreamCount counts headers.

	The written value is shorter than the one it replaces, which is the direction that used to leave the tail of the
	old value on the end of the new one (bug-binary-write-accessor-keeps-the-old-values-tail).
*/
begin
	var LBefore : Integer := StreamCount();
	begin
		var LB : Binary := Binary(LEight);
		var LCopy : Binary := LB;
		var LHeld : Integer := StreamCount();
		LCopy.Value := LFour;
		if StreamCount() <> LHeld then
			raise Error('Writing through a copy changed the count by ' + ToString(StreamCount() - LHeld) + '.');
		if LCopy.Value <> LFour then
			raise Error('Writing through a copy did not reach the copy.');
		if LB.Value <> LEight then
			raise Error('Writing through a copy changed the value it was taken from.');
	end;
	if StreamCount() <> LBefore then
		raise Error('Writing through a copy left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

// The same, over a chain of three, writing to the middle. A copy of a copy is not a sibling of the first copy - it
// hangs off the copy it was taken from - so the middle of a chain is a different structure from a pair.
begin
	var LBefore : Integer := StreamCount();
	begin
		var LFirst : Binary := Binary(LEight);
		var LSecond : Binary := LFirst;
		var LThird : Binary := LSecond;
		var LHeld : Integer := StreamCount();
		LSecond.Value := LFour;
		if StreamCount() <> LHeld then
			raise Error('Writing through the middle of a chain of three changed the count by ' + ToString(StreamCount() - LHeld) + '.');
		if LSecond.Value <> LFour then
			raise Error('Writing through the middle of a chain of three did not reach it.');
		if LFirst.Value <> LEight then
			raise Error('Writing through the middle of a chain of three changed the value above it.');
		if LThird.Value <> LEight then
			raise Error('Writing through the middle of a chain of three changed the value below it.');
	end;
	if StreamCount() <> LBefore then
		raise Error('Writing through the middle of a chain of three left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

/*
	Copy-on-write, through the original. This is the direction worth having in a script: it did nothing at all until
	bug-writing-a-large-value-changes-copies-of-it landed, because the write went into the one stream every copy was
	still reading through, so every copy silently followed it. A chain of two copies, so that the copy below the
	written variable and the copy below that one are both read back.
*/
begin
	var LBefore : Integer := StreamCount();
	begin
		var LB : Binary := Binary(LEight);
		var LCopy : Binary := LB;
		var LCopyOfCopy : Binary := LCopy;
		var LHeld : Integer := StreamCount();
		LB.Value := LFour;
		if StreamCount() <> LHeld then
			raise Error('Writing through the original changed the count by ' + ToString(StreamCount() - LHeld) + '.');
		if LB.Value <> LFour then
			raise Error('Writing through the original did not reach it.');
		if LCopy.Value <> LEight then
			raise Error('Writing through the original changed a copy taken from it.');
		if LCopyOfCopy.Value <> LEight then
			raise Error('Writing through the original changed a copy of a copy taken from it.');
	end;
	if StreamCount() <> LBefore then
		raise Error('Writing through the original left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

// Release, through the helper TestFramework.Coverage.Base carries for exactly this: TestStreamCount records the count,
// executes the statement text it is given and raises if the count moved. One whole statement that declares, copies and
// writes, so that the helper is exercised over the same shapes the blocks above take apart assertion by assertion.
begin
	var LStatement : String :=
		'begin '
			+ 'var LB : Binary := Binary("' + LEight + '"); '
			+ 'var LCopy : Binary := LB; '
			+ 'LCopy.Value := "' + LFour + '"; '
			+ 'if LB.Value <> "' + LEight + '" then raise Error("The value written through a copy reached the original."); '
			+ 'if LCopy.Value <> "' + LFour + '" then raise Error("The value written through a copy did not reach it."); '
		+ 'end;';
	TestStreamCount(LStatement);
end;

/*
	Rows, and a rolled-back transaction. One table, created and dropped inside this section so that the section as a
	whole can be asserted to balance.

	What is settled here, and asserted: a Binary read back out of a table column into a variable takes out no stream of
	its own, because the value in the column is stored natively; an update and a delete reach the row; and an insert
	inside a rolled-back transaction, of a value held in a variable that outlives the rollback, leaves the value intact
	and the count exactly where it was.

	What is not asserted, and why. This whole section is one statement, so it runs inside one transaction, and while
	that transaction is open the device session's undo log legitimately holds one managed stream for each write it has
	logged - one for the insert, one for the update, none for the delete, since the row a delete copies holds its value
	as plain bytes. That is correct: the memory device keeps no undo information of its own, so the engine's log is the
	only thing that could roll these statements back. It is also incidental bookkeeping, so the exact within-statement
	counts are deliberately not pinned here - an ordinary change to how the log copies a row would then fail a coverage
	script for no benefit. The log is released when the transaction ends, which is why this section balances at its end
	and why the script's closing assertion is still worth something: this section cannot quietly raise the floor under
	the cases after it.

	The balance that does matter - a committed insert, update or delete, each as its own statement, costing no stream -
	cannot be asserted from in here for the same reason, and is asserted at the script's top level in the section that
	follows this one.
*/
begin
	var LBefore : Integer := StreamCount();
	create table TStreamValues { ID : Integer, B : Binary, key { ID } };

	insert table { row { 1 ID, Binary(LEight) B } } into TStreamValues;
	begin
		var LHeld : Integer := StreamCount();
		var LRead : Binary := (B from row from (TStreamValues where ID = 1));
		if LRead.Value <> LEight then
			raise Error('A Binary read out of a table column was not the value inserted.');
		if StreamCount() <> LHeld then
			raise Error('Reading a Binary out of a table column into a variable took out ' + ToString(StreamCount() - LHeld) + ' stream(s).');
	end;

	update TStreamValues set { B := Binary(LFour) } where ID = 1;
	if (B from row from (TStreamValues where ID = 1)).Value <> LFour then
		raise Error('An update of a Binary column did not reach the row.');

	delete TStreamValues where ID = 1;
	if exists (TStreamValues where ID = 1) then
		raise Error('A delete did not remove the row.');

	// The rolled-back transaction. Note the form: transactions in D4 are the operators BeginTransaction(),
	// CommitTransaction() and RollbackTransaction(); there is no "begin transaction" statement, and a block containing
	// one is a syntax error. A standalone BeginTransaction() statement has no effect that outlives itself - the engine
	// wraps each statement in an implicit transaction and commits back down to the depth it started at - so it has to
	// be written inside a block, as it is here, or held open from the host through IServerProcess.BeginTransaction.
	// Rollback is not a special release: it disposes the undo log, which is exactly what a commit does, reached sooner.
	// So the balance asserted below says the same thing the committed cases in the next section say.
	begin
		var LB : Binary := Binary(LEight);
		var LHeld : Integer := StreamCount();
		BeginTransaction();
		insert table { row { 2 ID, LB B } } into TStreamValues;
		RollbackTransaction();
		if exists (TStreamValues where ID = 2) then
			raise Error('A rolled-back insert left its row behind.');
		if LB.Value <> LEight then
			raise Error('A value held in a variable across a rolled-back transaction did not survive it.');
		if StreamCount() <> LHeld then
			raise Error('A rolled-back transaction changed the count by ' + ToString(StreamCount() - LHeld) + '.');
	end;

	drop table TStreamValues;
	if StreamCount() <> LBefore then
		raise Error('The row section left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind once its table was dropped.');
end;

/*
	A committed write of a stream-backed value, each statement its own transaction. This section is written at the
	script's top level rather than inside a block, and that is the whole point of it: the engine wraps each top-level
	statement in its own transaction and commits it, so the undo log that holds a managed stream for the life of a
	transaction has released it again by the time the next statement runs. Written inside a block, as the row section
	above is, these assertions would be measuring one open transaction's bookkeeping instead, which is what the
	original reading of this behaviour as a leak was measuring.

	Top-level var declarations persist across the statements after them - the script already relies on this for
	LScriptStart - which is what lets a count be recorded in one statement and asserted against in a later one.

	This is also why the script's coverage-manifest.json entry carries "batches": true. Run the default way - as one
	nested ExecuteScript('Coverage.Scripts', 'StreamValues') call - the whole file is a single statement and these
	statements would all fall inside its open transaction, so the assertions below would fail - and fail reading exactly
	like the leak this script's history is about, which is why each of them names the entry in its message. If the entry
	is ever turned back, this section has to move out of the script and into a host test instead.
*/
// The three count assertions below carry this, because the way they fail if the manifest entry is ever turned back is
// indistinguishable, in the message alone, from the leak the original report claimed. TransactionCount() cannot be
// guarded on instead: it reads 1 here in both modes (measured) - what differs is whether that transaction outlives
// the statement, which is the very thing these assertions measure.
var LCommittedHint : String := ' Check that this script''s coverage-manifest.json entry still carries "batches": true before reading this as a leak.';

var LCommittedBefore : Integer := StreamCount();
create table TStreamCommitted { ID : Integer, B : Binary, key { ID } };

// The floor the write assertions are measured against, taken after the table exists and before anything is in it.
var LCommittedFloor : Integer := StreamCount();

insert table { row { 1 ID, Binary(LEight) B } } into TStreamCommitted;
if StreamCount() <> LCommittedFloor then
	raise Error('A committed insert of a Binary left ' + ToString(StreamCount() - LCommittedFloor) + ' stream(s) held.' + LCommittedHint);
if (B from row from (TStreamCommitted where ID = 1)).Value <> LEight then
	raise Error('A committed insert of a Binary did not store the value selected.');

update TStreamCommitted set { B := Binary(LFour) } where ID = 1;
if StreamCount() <> LCommittedFloor then
	raise Error('A committed update of a Binary column left ' + ToString(StreamCount() - LCommittedFloor) + ' stream(s) held.' + LCommittedHint);
if (B from row from (TStreamCommitted where ID = 1)).Value <> LFour then
	raise Error('A committed update of a Binary column did not reach the row.');

delete TStreamCommitted where ID = 1;
if StreamCount() <> LCommittedFloor then
	raise Error('A committed delete of a row with a Binary column left ' + ToString(StreamCount() - LCommittedFloor) + ' stream(s) held.' + LCommittedHint);
if exists (TStreamCommitted where ID = 1) then
	raise Error('A committed delete did not remove the row.');

// Dropping the table releases the undo entries of any transaction still holding some. Here there are none left to
// release, which is the assertion: the count was already back at its floor before the drop, not because of it.
drop table TStreamCommitted;
if StreamCount() <> LCommittedBefore then
	raise Error('The committed-write section left ' + ToString(StreamCount() - LCommittedBefore) + ' stream(s) behind.');

/*
	Equality over large values. iEqual(Binary, Binary) has a byte-array fast path and, below it, the branch that opens
	both streams and walks them a byte at a time; a selected value is never a byte array, so these comparisons take the
	streaming branch. Two values differing only in their last byte must compare unequal - a comparison that stopped
	early, or one that only compared lengths, would call them equal - and a value must compare equal to itself, which
	is the case that opens one stream twice at once.
*/
begin
	var LBefore : Integer := StreamCount();
	begin
		var LLeft : Binary := Binary(LLarge);
		var LRight : Binary := Binary(LLargeLastByteChanged);
		if Length(LLeft) <> Length(LRight) then
			raise Error('The two large values were not the same length.');
		if LLeft = LRight then
			raise Error('Two large values differing only in their last byte compared equal.');
		if not(LLeft = LLeft) then
			raise Error('A large value did not compare equal to itself.');
	end;
	if StreamCount() <> LBefore then
		raise Error('The equality case left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

// Nil. A variable of a stream-backed type with no value holds no stream, and IsNil says so; giving it a value takes
// one out. (Against a table column this would be a different question - inserting nil into a column declared
// "B : Binary" is refused with "Value required for column", so a nilable column of that type would have to be
// declared some other way - and the variable is where the stream assertion lives anyway.)
begin
	var LBefore : Integer := StreamCount();
	begin
		var LB : Binary;
		if StreamCount() <> LBefore then
			raise Error('A Binary variable with no value took out ' + ToString(StreamCount() - LBefore) + ' stream(s).');
		if not(IsNil(LB)) then
			raise Error('A Binary variable with no value was not nil.');
		LB := Binary(LFour);
		if StreamCount() <> LBefore + 1 then
			raise Error('Giving a nil Binary variable a value took out ' + ToString(StreamCount() - LBefore) + ' stream(s) rather than one.');
		if IsNil(LB) then
			raise Error('A Binary variable given a value was still nil.');
	end;
	if StreamCount() <> LBefore then
		raise Error('The nil case left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

/*
	Lists.

	A list holds one stream per stream-backed element, exactly as a variable of the element type does, and gives every
	one of them back when it goes out of scope. That release used to be missing altogether - a list value had no
	disposal of its own, so every element of every list of Binary or Graphic was held for the life of the session, and
	no loop was needed to provoke it: evaluating a list and throwing it away cost one stream per element
	(bug-a-list-value-never-releases-its-elements). The blocks below are the shapes that were measured against that
	defect, each of which left one stream per element behind: a list in a variable, a list evaluated and discarded, the
	three forms of foreach over a list, a list of rows, a row with a list column, a list of lists, an element read back
	into a variable, an assignment over a list variable, and a list returned from an operator.

	Add and Insert are here for the other half of the same rule - a list copies what it is given, and the caller keeps
	owning what it passed. Those two used to take a plain value as it stood while the call that handed it over released
	it afterwards, so the element was in the list and the list's count said so, but reading it failed with
	"StreamID (n) not found". Both blocks therefore assert the value read back and not only the count.

	The loop variable of a foreach over a list is nil once the loop has finished, which the block below asserts with
	IsNil - a comparison with a nil operand yields nil and would not fire. It is lent the list's own element rather than
	given a copy, so the slot is nulled on the way out, which is what a foreach over a cursor has always done.
*/
begin
	var LBefore : Integer := StreamCount();
	begin
		var LL : list(Binary) := { Binary(LEight), Binary(LFour) };
		if StreamCount() <> LBefore + 2 then
			raise Error('A list of two Binary values held ' + ToString(StreamCount() - LBefore) + ' stream(s) rather than two.');
		if LL.Count() <> 2 then
			raise Error('A list of two Binary values reported ' + ToString(LL.Count()) + ' element(s).');
		if LL[0].Value <> LEight then
			raise Error('The first element of a list of Binary did not read back as the value selected.');
		if LL[1].Value <> LFour then
			raise Error('The second element of a list of Binary did not read back as the value selected.');
	end;
	if StreamCount() <> LBefore then
		raise Error('A list of two Binary values left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

// One element rather than two, because a release that ran only for the last element would balance the block above.
begin
	var LBefore : Integer := StreamCount();
	begin
		var LL : list(Binary) := { Binary(LEight) };
		if StreamCount() <> LBefore + 1 then
			raise Error('A list of one Binary value held ' + ToString(StreamCount() - LBefore) + ' stream(s) rather than one.');
	end;
	if StreamCount() <> LBefore then
		raise Error('A list of one Binary value left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

// A list that is evaluated and thrown away: no list variable is declared at all, so nothing but the list itself can
// release the elements.
begin
	var LBefore : Integer := StreamCount();
	begin
		var LI : Integer := ({ Binary(LEight), Binary(LFour) }).Count();
		if LI <> 2 then
			raise Error('A list selector handed straight to Count() reported ' + ToString(LI) + ' element(s).');
	end;
	if StreamCount() <> LBefore then
		raise Error('A list that was evaluated and discarded left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

// foreach over a list variable, with a loop variable the script declared itself - the one form that can see the slot
// after the loop.
begin
	var LBefore : Integer := StreamCount();
	begin
		var LL : list(Binary) := { Binary(LEight), Binary(LFour) };
		var LB : Binary;
		var LCount : Integer := 0;
		foreach LB in LL do
			LCount := LCount + 1;
		if LCount <> 2 then
			raise Error('A foreach over a list of two ran ' + ToString(LCount) + ' time(s).');
		if not(IsNil(LB)) then
			raise Error('A foreach over a list left its loop variable holding a value; the variable is lent the list''s own element, so it must be nil once the loop has finished.');
	end;
	if StreamCount() <> LBefore then
		raise Error('A foreach over a list variable left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

// The same, with the loop allocating its own variable.
begin
	var LBefore : Integer := StreamCount();
	begin
		var LL : list(Binary) := { Binary(LEight), Binary(LFour) };
		var LCount : Integer := 0;
		foreach var LB in LL do
			LCount := LCount + 1;
		if LCount <> 2 then
			raise Error('A foreach allocating its own variable ran ' + ToString(LCount) + ' time(s) over a list of two.');
	end;
	if StreamCount() <> LBefore then
		raise Error('A foreach allocating its own variable left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

// And over a list selector rather than a variable, so that nothing holds the list but the loop.
begin
	var LBefore : Integer := StreamCount();
	begin
		var LCount : Integer := 0;
		foreach var LB in { Binary(LEight), Binary(LFour) } do
			LCount := LCount + 1;
		if LCount <> 2 then
			raise Error('A foreach over a list selector ran ' + ToString(LCount) + ' time(s) over a list of two.');
	end;
	if StreamCount() <> LBefore then
		raise Error('A foreach over a list selector left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

// A row with a list column, and a list of rows: the two shapes in which one container holds the other, each of which
// has to release through the one in the middle.
begin
	var LBefore : Integer := StreamCount();
	begin
		var LR : row { L : list(Binary) } := row { { Binary(LEight), Binary(LFour) } L };
		if (L from LR).Count() <> 2 then
			raise Error('A list column of a row reported ' + ToString((L from LR).Count()) + ' element(s).');
	end;
	if StreamCount() <> LBefore then
		raise Error('A row with a list column left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

begin
	var LBefore : Integer := StreamCount();
	begin
		var LL : list(row { B : Binary }) := { row { Binary(LEight) B }, row { Binary(LFour) B } };
		if (B from LL[1]).Value <> LFour then
			raise Error('The second row of a list of rows did not read back as the value selected.');
	end;
	if StreamCount() <> LBefore then
		raise Error('A list of rows left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

begin
	var LBefore : Integer := StreamCount();
	begin
		var LL : list(list(Binary)) := { { Binary(LEight) }, { Binary(LFour) } };
		if LL[1][0].Value <> LFour then
			raise Error('The element of the second list of a list of lists did not read back as the value selected.');
	end;
	if StreamCount() <> LBefore then
		raise Error('A list of lists left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

// Reading an element out into a variable of its own: the variable owns its copy and the list still owns the element.
begin
	var LBefore : Integer := StreamCount();
	begin
		var LL : list(Binary) := { Binary(LEight), Binary(LFour) };
		var LB : Binary := LL[0];
		if LB.Value <> LEight then
			raise Error('An element read out of a list was not the value selected.');
		if LL[0].Value <> LEight then
			raise Error('Reading an element out of a list changed the element.');
	end;
	if StreamCount() <> LBefore then
		raise Error('Reading an element out of a list left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

// Assignment over a list variable: the slot releases the list it displaced, which now means that list's elements too.
begin
	var LBefore : Integer := StreamCount();
	begin
		var LL : list(Binary) := { Binary(LEight) };
		LL := { Binary(LFour) };
		if LL.Count() <> 1 then
			raise Error('A list assigned over a list of one held ' + ToString(LL.Count()) + ' element(s).');
		if LL[0].Value <> LFour then
			raise Error('A list assigned over another did not read back as the value assigned.');
	end;
	if StreamCount() <> LBefore then
		raise Error('Assigning over a list variable left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

/*
	Add and Insert. Both hand a value to a list that the call then releases, which is what used to leave the list
	pointing at a released stream: the count said the element was there and reading it raised "StreamID (n) not found".
	The element already in the list is read back as well, because a copy taken in the wrong place would be as likely to
	disturb that one.
*/
begin
	var LBefore : Integer := StreamCount();
	begin
		var LL : list(Binary) := { Binary(LEight) };
		LL.Add(Binary(LFour));
		if LL.Count() <> 2 then
			raise Error('Adding to a list of one left ' + ToString(LL.Count()) + ' element(s).');
		if LL[1].Value <> LFour then
			raise Error('An element added to a list did not read back as the value added.');
		if LL[0].Value <> LEight then
			raise Error('Adding to a list changed the element it already held.');
	end;
	if StreamCount() <> LBefore then
		raise Error('Adding to a list left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

begin
	var LBefore : Integer := StreamCount();
	begin
		var LL : list(Binary) := { Binary(LEight) };
		LL.Insert(Binary(LFour), 0);
		if LL.Count() <> 2 then
			raise Error('Inserting into a list of one left ' + ToString(LL.Count()) + ' element(s).');
		if LL[0].Value <> LFour then
			raise Error('An element inserted into a list did not read back as the value inserted.');
		if LL[1].Value <> LEight then
			raise Error('Inserting into a list changed the element it already held.');
	end;
	if StreamCount() <> LBefore then
		raise Error('Inserting into a list left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

/*
	A list part way built when something raises. The elements already copied into a partial list are the list's, so
	whoever is building it has to release it on the way out rather than leave a list nothing holds - and that is the one
	path none of the blocks above measures, because all of them run to completion. Two shapes have it: an element of a
	list selector raising after an earlier element is in, and the return expression of a foreach raising on a later
	element. ToList has the same shape in both of its branches and is not covered here: a cursor that raises part way
	through its own iteration is not something a D4 script can arrange.

	The operator raises on one given value rather than counting its calls, so that which iteration raises is readable
	from the block itself; it takes the value to raise on as a parameter because an operator body cannot see this
	script's variables.
*/
create operator TestRaiseOn(const AValue : Binary, const ARaiseOn : String) : Binary
begin
	if AValue.Value = ARaiseOn then
		raise Error('TestRaiseOn');
	result := AValue;
end;

begin
	var LBefore : Integer := StreamCount();
	begin
		var LL : list(Binary);
		var LCaught : Integer := 0;
		try
			LL := { Binary(LEight), TestRaiseOn(Binary(LFour), LFour) };
		except
			on E : Error do
				LCaught := 1;
		end;
		if LCaught <> 1 then
			raise Error('The second element of the list selector did not raise.');
		if not(IsNil(LL)) then
			raise Error('The assignment completed even though the list selector raised.');
	end;
	if StreamCount() <> LBefore then
		raise Error('A list selector whose element raised left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

begin
	var LBefore : Integer := StreamCount();
	begin
		var LL : list(Binary) := { Binary(LEight), Binary(LFour) };
		var LD : list(Binary);
		var LCaught : Integer := 0;
		try
			LD := foreach var LB in LL do TestRaiseOn(LB, LFour);
		except
			on E : Error do
				LCaught := 1;
		end;
		if LCaught <> 1 then
			raise Error('The return expression of the foreach did not raise on the second element.');
		if LL[0].Value <> LEight then
			raise Error('A foreach that raised released an element of the list it was reading.');
	end;
	if StreamCount() <> LBefore then
		raise Error('A foreach whose return expression raised left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

drop operator TestRaiseOn(Binary, String);

/*
	Distinct over a list of stream-backed values. The operator builds a set to find the duplicates with, and that set
	releases every element it holds when it is dropped, so what goes into it has to be a copy rather than the source
	list's own element. Given the element itself, the drop released a value both the source list and the result were
	still pointing at: before a list released its elements that produced a result whose elements read as released
	streams, and afterwards a second release of one stream, reported as "StreamID (n) not found". Both lists are read
	back here for that reason.

	What this block deliberately does not assert is the number of elements the result has. Distinct does not in fact
	remove the duplicate from a list of Binary or Graphic - the set hashes a value by where it is stored rather than by
	what it contains, so two equal values never meet to be compared - and that is
	bug-distinct-leaves-duplicate-pictures-in-a-list, met while writing this block and filed with its measurement. The
	count is left unasserted rather than pinned to today's wrong answer, so that this block keeps saying something true
	when that defect is fixed.
*/
begin
	var LBefore : Integer := StreamCount();
	begin
		var LL : list(Binary) := { Binary(LEight), Binary(LFour), Binary(LEight) };
		var LD : list(Binary) := LL.Distinct();
		if LD.Count() < 2 then
			raise Error('Distinct over a list of three held ' + ToString(LD.Count()) + ' element(s); the two distinct values must both be in it.');
		if LD[0].Value <> LEight then
			raise Error('The first element of a distinct list did not read back as the value selected.');
		if LD[1].Value <> LFour then
			raise Error('The second element of a distinct list did not read back as the value selected.');
		if LL[2].Value <> LEight then
			raise Error('Distinct released an element of the list it read.');
	end;
	if StreamCount() <> LBefore then
		raise Error('Distinct over a list left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

// A list an operator built and returned: the result is handed to the caller rather than released, and the caller's
// variable is what releases it.
create operator TestBinaryList(const AValue : String) : list(Binary)
begin
	result := { Binary(AValue), Binary(AValue) };
end;

begin
	var LBefore : Integer := StreamCount();
	begin
		var LL : list(Binary) := TestBinaryList(LEight);
		if LL.Count() <> 2 then
			raise Error('A list returned from an operator held ' + ToString(LL.Count()) + ' element(s) rather than two.');
		if LL[1].Value <> LEight then
			raise Error('An element of a list returned from an operator did not read back as the value the operator selected.');
	end;
	if StreamCount() <> LBefore then
		raise Error('A list returned from an operator left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

drop operator TestBinaryList(String);

/*
	Graphic. One pass rather than the full set above, and that is not a shortcut: Binary and Graphic are declared side
	by side in DataTypes.d4 over the same selector node, the same Value read and write accessor nodes, the same
	conveyor and the same equality operator class, and differ only in their AsDisplayString representation and their
	Frontend tags. So what this pass is for is the declaration itself - that Graphic really is registered that way -
	rather than a second copy of the stream behaviour.
*/
begin
	var LBefore : Integer := StreamCount();
	begin
		var LG : Graphic := Graphic(LEight);
		if StreamCount() <> LBefore + 1 then
			raise Error('A Graphic variable took out ' + ToString(StreamCount() - LBefore) + ' stream(s) rather than one.');
		if LG.Value <> LEight then
			raise Error('A Graphic did not read back through Value as the value selected.');
		if ToBase64String(LG) <> LEight then
			raise Error('A Graphic did not read back through ToBase64String as the value selected.');
		if Length(LG) <> ToLong(8) then
			raise Error('A Graphic of 8 bytes reported a length of ' + ToString(Length(LG)) + '.');

		var LCopy : Graphic := LG;
		if StreamCount() <> LBefore + 2 then
			raise Error('A Graphic and a copy of it held ' + ToString(StreamCount() - LBefore) + ' stream(s) rather than two.');
		if not(LCopy = LG) then
			raise Error('A copy of a Graphic did not compare equal to it.');

		LG.Value := LFour;
		if LG.Value <> LFour then
			raise Error('Writing through a Graphic did not reach it.');
		if LCopy.Value <> LEight then
			raise Error('Writing through a Graphic changed a copy taken from it.');
		if StreamCount() <> LBefore + 2 then
			raise Error('Writing through a Graphic changed the count to ' + ToString(StreamCount() - LBefore) + ' stream(s) held rather than two.');
	end;
	if StreamCount() <> LBefore then
		raise Error('The Graphic case left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

begin
	var LBefore : Integer := StreamCount();
	begin
		var LG : Graphic;
		if StreamCount() <> LBefore then
			raise Error('A Graphic variable with no value took out ' + ToString(StreamCount() - LBefore) + ' stream(s).');
		if not(IsNil(LG)) then
			raise Error('A Graphic variable with no value was not nil.');
	end;
	if StreamCount() <> LBefore then
		raise Error('The nil Graphic case left ' + ToString(StreamCount() - LBefore) + ' stream(s) behind.');
end;

drop operator TestBinaryValue(String, Integer);

// Everything the script declared has gone out of scope, so the server is holding exactly what it held at the start.
if StreamCount() <> LScriptStart then
	raise Error('The script as a whole left ' + ToString(StreamCount() - LScriptStart) + ' stream(s) behind.');
