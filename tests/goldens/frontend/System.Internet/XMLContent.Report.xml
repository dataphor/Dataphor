<report xmlns:bop="www.alphora.com/schemas/bop">
	<source bop:name="Main" expression="(&#xD;&#xA; System.Internet.XMLContent&#xD;&#xA;  rename Main&#xD;&#xA;)&#xD;&#xA; browse by { Main.Element_ID asc include nil, Main.Sequence asc include nil }&#xD;&#xA;capabilities { navigable, backwardsnavigable, bookmarkable, searchable, updateable }&#xD;&#xA;isolation browse" />
	<header bop:name="PageHeader" height="15">
		<textarea bop:name="ReportName" text="XMLContent Report" y="0" />
		<date bop:name="HeaderDate" x="520" y="0" />
	</header>
	<databand bop:name="RootDataBand" source="Main">
		<header bop:name="RootDataBandHeader">
			<box bop:name="RootDataBandHeaderBox" height="11" width="600" x="5" y="2" />
			<textarea bop:name="MainColumnElement_IDHeader" text="Element ID" x="10" y="3" maxlength="36" />
			<textarea bop:name="MainColumnSequenceHeader" text="Sequence" x="190" y="3" maxlength="40" />
			<textarea bop:name="MainColumnTypeHeader" text="Content Type" x="390" y="3" maxlength="40" />
			<textarea bop:name="MainColumnContentHeader" text="Content" x="590" y="3" maxlength="40" />
		</header>
		<staticgroup bop:name="RootDataBandContent">
			<field bop:name="MainColumnElement_ID" source="Main" columnname="Element_ID" x="10" maxlength="36" />
			<field bop:name="MainColumnSequence" source="Main" columnname="Sequence" x="190" maxlength="40" />
			<field bop:name="MainColumnType" source="Main" columnname="Type" x="390" maxlength="40" />
			<field bop:name="MainColumnContent" source="Main" columnname="Content" x="590" maxlength="40" />
		</staticgroup>
	</databand>
	<footer bop:name="PageFooter" height="20">
		<textarea bop:name="PageFooterPageText" text="Page" x="290" y="5" />
		<pagenumber bop:name="PageFooterPageNumber" x="310" y="5" />
	</footer>
</report>
