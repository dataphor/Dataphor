		<menu bop:name="Main.Right_Name.System.UserRightAssignments_RightsLookupMenuItem" action="Main.Right_Name.System.UserRightAssignments_Rights" />
	</menu>
	<sourceaction bop:name="Validate" source="Main" text="&amp;Validate" action="Validate" />
	<column bop:name="RootEditColumn">
