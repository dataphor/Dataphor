			<quicklookup bop:name="MainColumnSystem.UserRightAssignments_Users_Main.User_ID_Lookup" title="User ID" source="Main" columnname="Main.User_ID" lookupcolumnname="Main.ID" document=".Frontend.Derive('System.Users', 'List', '', '', true)">
