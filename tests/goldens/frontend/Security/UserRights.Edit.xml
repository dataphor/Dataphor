<interface xmlns:bop="www.alphora.com/schemas/bop" text="Edit UserRights" mainsource="Main">
	<source bop:name="Main" expression="(&#xD;&#xA; Security.UserRights&#xD;&#xA;  rename Main&#xD;&#xA;)&#xD;&#xA; browse by { Main.User_ID asc include nil, Main.Right_Name asc include nil }&#xD;&#xA;capabilities { navigable, backwardsnavigable, bookmarkable, searchable, updateable }&#xD;&#xA;isolation browse" isreadonly="True" />
	<showformaction bop:name="Main.User_ID.System.UserRightAssignments_Users" text="Users..." document=".Frontend.Derive('System.Users', 'View', '', '', true)" sourcelinktype="Detail" sourcelink.source="Main" sourcelink.masterkeynames="Main.User_ID" sourcelink.detailkeynames="Main.ID" sourcelinkrefresh="False" />
	<showformaction bop:name="Main.Right_Name.System.UserRightAssignments_Rights" text="Rights..." document=".Frontend.Derive('System.Rights', 'View', '', '', true)" sourcelinktype="Detail" sourcelink.source="Main" sourcelink.masterkeynames="Main.Right_Name" sourcelink.detailkeynames="Main.Name" sourcelinkrefresh="False" />
	<menu bop:name="LookupViewMenuItem" text="Vie&amp;w">
