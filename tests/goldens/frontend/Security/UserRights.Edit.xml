			<checkbox bop:name="MainColumnMain.HasAssignment" title="Has Assignment" source="Main" columnname="Main.HasAssignment" readonly="True" />
			<checkbox bop:name="MainColumnMain.IsGranted" title="IsGranted" source="Main" columnname="Main.IsGranted" readonly="True" />
