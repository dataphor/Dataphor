		<menu bop:name="Main.Device_Name.System.DeviceUsers_DevicesLookupMenuItem" action="Main.Device_Name.System.DeviceUsers_Devices" />
		<menu bop:name="Main.User_ID.System.DeviceUsers_UsersLookupMenuItem" action="Main.User_ID.System.DeviceUsers_Users" />
	</menu>
	<sourceaction bop:name="Validate" source="Main" text="&amp;Validate" action="Validate" />
	<column bop:name="RootEditColumn">
		<column bop:name="Element1">
			<quicklookup bop:name="MainColumnSecurity.UserDeviceUser_DevicesView_Main.Device_Name_Lookup" title="Device Name" source="Main" columnname="Main.Device_Name" lookupcolumnname="Main.Name" document=".Frontend.Derive('Security.DevicesView', 'List', '', '', false)" readonly="True">
				<textbox bop:name="MainColumnSecurity.UserDeviceUser_DevicesView_Main.Device_Name" title="Device Name" width="50" source="Main" columnname="Main.Device_Name" readonly="True" titlealignment="None" />
			</quicklookup>
			<quicklookup bop:name="MainColumnSystem.DeviceUsers_Devices_Main.Device_Name_Lookup" title="Device Name" source="Main" columnname="Main.Device_Name" lookupcolumnname="Main.Name" document=".Frontend.Derive('System.Devices', 'List', '', '', true)" readonly="True">
				<textbox bop:name="MainColumnSystem.DeviceUsers_Devices_Main.Device_Name" title="Device Name" width="50" source="Main" columnname="Main.Device_Name" readonly="True" titlealignment="None" />
			</quicklookup>
			<quicklookup bop:name="MainColumnSystem.DeviceUsers_Users_Main.User_ID_Lookup" title="User ID" source="Main" columnname="Main.User_ID" lookupcolumnname="Main.ID" document=".Frontend.Derive('System.Users', 'List', '', '', true)" readonly="True">
				<textbox bop:name="MainColumnSystem.DeviceUsers_Users_Main.User_ID" title="User ID" maxlength="255" maxwidth="15" width="10" source="Main" columnname="Main.User_ID" readonly="True" titlealignment="None" />
