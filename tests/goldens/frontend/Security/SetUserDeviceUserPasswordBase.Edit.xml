			<textbox bop:name="MainColumnMain.Password" title="Password" ispassword="true" nilifblank="False" source="Main" columnname="Main.Password" />
			<textbox bop:name="MainColumnMain.ConfirmPassword" title="Confirm Password" ispassword="true" nilifblank="False" source="Main" columnname="Main.ConfirmPassword" />
		</column>
	</column>
</interface>
