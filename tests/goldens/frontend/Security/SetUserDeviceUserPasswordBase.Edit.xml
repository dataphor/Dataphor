<interface xmlns:bop="www.alphora.com/schemas/bop" text="Edit Device User" mainsource="Main">
	<source bop:name="Main" expression="(&#xD;&#xA; Security.SetUserDeviceUserPasswordBase&#xD;&#xA;  rename Main&#xD;&#xA;)&#xD;&#xA; browse by { Main.Device_Name asc include nil, Main.User_ID asc include nil }&#xD;&#xA;capabilities { navigable, backwardsnavigable, bookmarkable, searchable, updateable }&#xD;&#xA;isolation browse" useapplicationtransactions="False" />
	<showformaction bop:name="Main.Device_Name.Security.UserDeviceUser_DevicesView" text="Device..." document=".Frontend.Derive('Security.DevicesView', 'View', '', '', false)" sourcelinktype="Detail" sourcelink.source="Main" sourcelink.masterkeynames="Main.Device_Name" sourcelink.detailkeynames="Main.Name" sourcelinkrefresh="False" />
	<showformaction bop:name="Main.Device_Name.System.DeviceUsers_Devices" text="Devices..." document=".Frontend.Derive('System.Devices', 'View', '', '', true)" sourcelinktype="Detail" sourcelink.source="Main" sourcelink.masterkeynames="Main.Device_Name" sourcelink.detailkeynames="Main.Name" sourcelinkrefresh="False" />
	<showformaction bop:name="Main.User_ID.System.DeviceUsers_Users" text="Users..." document=".Frontend.Derive('System.Users', 'View', '', '', true)" sourcelinktype="Detail" sourcelink.source="Main" sourcelink.masterkeynames="Main.User_ID" sourcelink.detailkeynames="Main.ID" sourcelinkrefresh="False" />
