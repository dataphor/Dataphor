<report xmlns:bop="www.alphora.com/schemas/bop">
	<source bop:name="Main" expression="(&#xD;&#xA; Security.UserRights&#xD;&#xA;  rename Main&#xD;&#xA;)&#xD;&#xA; browse by { Main.User_ID asc include nil, Main.Right_Name asc include nil }&#xD;&#xA;capabilities { navigable, backwardsnavigable, bookmarkable, searchable, updateable }&#xD;&#xA;isolation browse" isreadonly="True" />
	<header bop:name="PageHeader" height="15">
		<textarea bop:name="ReportName" text="UserRights Report" y="0" />
		<date bop:name="HeaderDate" x="520" y="0" />
	</header>
	<databand bop:name="RootDataBand" source="Main">
		<header bop:name="RootDataBandHeader">
			<box bop:name="RootDataBandHeaderBox" height="11" width="600" x="5" y="2" />
			<textarea bop:name="MainColumnUser_IDHeader" text="User ID" x="10" y="3" maxlength="10" />
			<textarea bop:name="MainColumnRight_NameHeader" text="Right Name" x="60" y="3" maxlength="50" />
			<textarea bop:name="MainColumnHasRightHeader" text="Has Right" x="310" y="3" maxlength="40" />
			<textarea bop:name="MainColumnHasAssignmentHeader" text="Has Assignment" x="510" y="3" maxlength="40" />
			<textarea bop:name="MainColumnIsGrantedHeader" text="IsGranted" x="710" y="3" maxlength="40" />
		</header>
		<staticgroup bop:name="RootDataBandContent">
			<field bop:name="MainColumnUser_ID" source="Main" columnname="User_ID" x="10" maxlength="10" />
			<field bop:name="MainColumnRight_Name" source="Main" columnname="Right_Name" x="60" maxlength="50" />
			<field bop:name="MainColumnHasRight" source="Main" columnname="HasRight" x="310" maxlength="40" />
			<field bop:name="MainColumnHasAssignment" source="Main" columnname="HasAssignment" x="510" maxlength="40" />
			<field bop:name="MainColumnIsGranted" source="Main" columnname="IsGranted" x="710" maxlength="40" />
		</staticgroup>
	</databand>
	<footer bop:name="PageFooter" height="20">
		<textarea bop:name="PageFooterPageText" text="Page" x="290" y="5" />
		<pagenumber bop:name="PageFooterPageNumber" x="310" y="5" />
	</footer>
</report>
