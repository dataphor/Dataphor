<report xmlns:bop="www.alphora.com/schemas/bop">
	<source bop:name="Main" expression="(&#xD;&#xA; Security.AddUserDeviceUser&#xD;&#xA;  rename Main&#xD;&#xA;)&#xD;&#xA; browse by { Main.Device_Name asc include nil, Main.User_ID asc include nil }&#xD;&#xA;capabilities { navigable, backwardsnavigable, bookmarkable, searchable, updateable }&#xD;&#xA;isolation browse" useapplicationtransactions="False" />
	<header bop:name="PageHeader" height="15">
		<textarea bop:name="ReportName" text="Device User Report" y="0" />
		<date bop:name="HeaderDate" x="520" y="0" />
	</header>
	<databand bop:name="RootDataBand" source="Main">
		<header bop:name="RootDataBandHeader">
			<box bop:name="RootDataBandHeaderBox" height="11" width="600" x="5" y="2" />
			<textarea bop:name="MainColumnUser_IDHeader" text="User ID" x="10" y="3" maxlength="10" />
			<textarea bop:name="MainColumnDevice_NameHeader" text="Device Name" x="60" y="3" maxlength="50" />
			<textarea bop:name="MainColumnUserIDHeader" text="User ID" x="310" y="3" maxlength="40" />
			<textarea bop:name="MainColumnConnectionParametersHeader" text="Connection Parameters" x="510" y="3" maxlength="40" />
			<textarea bop:name="MainColumnPasswordHeader" text="Password" x="710" y="3" maxlength="40" />
			<textarea bop:name="MainColumnConfirmPasswordHeader" text="Confirm Password" x="910" y="3" maxlength="40" />
		</header>
		<staticgroup bop:name="RootDataBandContent">
			<field bop:name="MainColumnUser_ID" source="Main" columnname="User_ID" x="10" maxlength="10" />
			<field bop:name="MainColumnDevice_Name" source="Main" columnname="Device_Name" x="60" maxlength="50" />
			<field bop:name="MainColumnUserID" source="Main" columnname="UserID" x="310" maxlength="40" />
			<field bop:name="MainColumnConnectionParameters" source="Main" columnname="ConnectionParameters" x="510" maxlength="40" />
			<field bop:name="MainColumnPassword" source="Main" columnname="Password" x="710" maxlength="40" />
			<field bop:name="MainColumnConfirmPassword" source="Main" columnname="ConfirmPassword" x="910" maxlength="40" />
		</staticgroup>
	</databand>
	<footer bop:name="PageFooter" height="20">
		<textarea bop:name="PageFooterPageText" text="Page" x="290" y="5" />
		<pagenumber bop:name="PageFooterPageNumber" x="310" y="5" />
	</footer>
</report>
