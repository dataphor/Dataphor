<report xmlns:bop="www.alphora.com/schemas/bop">
	<source bop:name="Main" expression="(&#xD;&#xA; Security.ChangePasswordBase&#xD;&#xA;  rename Main&#xD;&#xA;)&#xD;&#xA;capabilities { navigable, backwardsnavigable, bookmarkable, searchable, updateable }&#xD;&#xA;isolation browse" />
	<header bop:name="PageHeader" height="15">
		<textarea bop:name="ReportName" text="ChangePasswordBase Report" y="0" />
		<date bop:name="HeaderDate" x="520" y="0" />
	</header>
	<databand bop:name="RootDataBand" source="Main">
		<header bop:name="RootDataBandHeader">
			<box bop:name="RootDataBandHeaderBox" height="11" width="600" x="5" y="2" />
			<textarea bop:name="MainColumnOldPasswordHeader" text="Old Password" x="10" y="3" maxlength="40" />
			<textarea bop:name="MainColumnNewPasswordHeader" text="New Password" x="210" y="3" maxlength="40" />
			<textarea bop:name="MainColumnConfirmNewPasswordHeader" text="Confirm New Password" x="410" y="3" maxlength="40" />
		</header>
		<staticgroup bop:name="RootDataBandContent">
			<field bop:name="MainColumnOldPassword" source="Main" columnname="OldPassword" x="10" maxlength="40" />
			<field bop:name="MainColumnNewPassword" source="Main" columnname="NewPassword" x="210" maxlength="40" />
			<field bop:name="MainColumnConfirmNewPassword" source="Main" columnname="ConfirmNewPassword" x="410" maxlength="40" />
		</staticgroup>
	</databand>
	<footer bop:name="PageFooter" height="20">
		<textarea bop:name="PageFooterPageText" text="Page" x="290" y="5" />
		<pagenumber bop:name="PageFooterPageNumber" x="310" y="5" />
	</footer>
</report>
