<interface xmlns:bop="www.alphora.com/schemas/bop" text="Delete Device User" mainsource="Main">
	<source bop:name="Main" expression="(&#xD;&#xA; Security.AddUserDeviceUser&#xD;&#xA;  rename Main&#xD;&#xA;)&#xD;&#xA; browse by { Main.Device_Name asc include nil, Main.User_ID asc include nil }&#xD;&#xA;capabilities { navigable, backwardsnavigable, bookmarkable, searchable, updateable }&#xD;&#xA;isolation browse" useapplicationtransactions="False" />
	<showformaction bop:name="Main.Device_Name.Security.UserDeviceUser_DevicesView" text="Device..." document=".Frontend.Derive('Security.DevicesView', 'View', '', '', false)" sourcelinktype="Detail" sourcelink.source="Main" sourcelink.masterkeynames="Main.Device_Name" sourcelink.detailkeynames="Main.Name" sourcelinkrefresh="False" />
	<showformaction bop:name="Main.User_ID.System.DeviceUsers_Users" text="Users..." document=".Frontend.Derive('System.Users', 'View', '', '', true)" sourcelinktype="Detail" sourcelink.source="Main" sourcelink.masterkeynames="Main.User_ID" sourcelink.detailkeynames="Main.ID" sourcelinkrefresh="False" />
	<menu bop:name="LookupViewMenuItem" text="Vie&amp;w">
		<menu bop:name="Main.Device_Name.Security.UserDeviceUser_DevicesViewLookupMenuItem" action="Main.Device_Name.Security.UserDeviceUser_DevicesView" />
		<menu bop:name="Main.User_ID.System.DeviceUsers_UsersLookupMenuItem" action="Main.User_ID.System.DeviceUsers_Users" />
	</menu>
	<sourceaction bop:name="Validate" source="Main" text="&amp;Validate" action="Validate" />
	<row bop:name="RootDeleteRow">
		<staticimage bop:name="DeleteImage" image="Image('Frontend', 'Image.Warning')" imagewidth="32" imageheight="32" />
		<group bop:name="DeleteGroup" title="Press Accept to delete the following row:">
			<column bop:name="DeleteColumn">
				<column bop:name="Element1">
					<textbox bop:name="MainColumnSystem.DeviceUsers_Users_Main.User_ID" title="User ID" maxlength="255" maxwidth="15" width="10" source="Main" columnname="Main.User_ID" readonly="True" />
					<textbox bop:name="MainColumnSecurity.UserDeviceUser_DevicesView_Main.Device_Name" title="Device Name" width="50" source="Main" columnname="Main.Device_Name" readonly="True" />
					<textbox bop:name="MainColumnMain.UserID" title="User ID" hint="The user id used to login to the given device." nilifblank="False" source="Main" columnname="Main.UserID" readonly="True" />
					<textbox bop:name="MainColumnMain.ConnectionParameters" title="Connection Parameters" hint="A semi-colon delimited list of name=value pairs of connection parameters to be used when connecting to this device" nilifblank="False" source="Main" columnname="Main.ConnectionParameters" readonly="True" />
					<textbox bop:name="MainColumnMain.Password" title="Password" ispassword="true" nilifblank="False" source="Main" columnname="Main.Password" readonly="True" />
					<textbox bop:name="MainColumnMain.ConfirmPassword" title="Confirm Password" ispassword="true" nilifblank="False" source="Main" columnname="Main.ConfirmPassword" readonly="True" />
				</column>
			</column>
		</group>
	</row>
</interface>
