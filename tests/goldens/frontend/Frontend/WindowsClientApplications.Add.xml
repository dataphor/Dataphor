<interface xmlns:bop="www.alphora.com/schemas/bop" text="Add Windows Client Application Settings" mainsource="Main">
	<source bop:name="Main" expression="(&#xD;&#xA; (&#xD;&#xA;  Frontend.WindowsClientApplications&#xD;&#xA;   rename Main&#xD;&#xA; )&#xD;&#xA;  left lookup&#xD;&#xA;  (&#xD;&#xA;   (&#xD;&#xA;    Frontend.Applications&#xD;&#xA;     over { .ID, .Description }&#xD;&#xA;   )&#xD;&#xA;    rename Applications&#xD;&#xA;  )&#xD;&#xA;  by (.Main.Application_ID = .Applications.ID)&#xD;&#xA;)&#xD;&#xA; browse by { Main.Application_ID asc include nil }&#xD;&#xA;capabilities { navigable, backwardsnavigable, bookmarkable, searchable, updateable }&#xD;&#xA;isolation browse" />
	<showformaction bop:name="Main.Application_ID.Frontend.WindowsClientApplications_Applications" text="Applications..." document=".Frontend.Derive('Frontend.Applications', 'View', '', '', true)" sourcelinktype="Detail" sourcelink.source="Main" sourcelink.masterkeynames="Main.Application_ID" sourcelink.detailkeynames="Main.ID" sourcelinkrefresh="False" />
	<menu bop:name="LookupViewMenuItem" text="Vie&amp;w">
		<menu bop:name="Main.Application_ID.Frontend.WindowsClientApplications_ApplicationsLookupMenuItem" action="Main.Application_ID.Frontend.WindowsClientApplications_Applications" />
	</menu>
	<sourceaction bop:name="Validate" source="Main" text="&amp;Validate" action="Validate" />
	<column bop:name="RootEditColumn">
		<column bop:name="Element1">
			<group bop:name="Main.Application_ID.Frontend.WindowsClientApplications_ApplicationsGroup" title="Applications">
				<row bop:name="Element2">
					<quicklookup bop:name="MainColumnFrontend.WindowsClientApplications_Applications_Main.Application_ID_Lookup" title="Application_ID" source="Main" columnname="Main.Application_ID" lookupcolumnname="Main.ID" document=".Frontend.Derive('Frontend.Applications', 'Browse', '', '', true)">
						<textbox bop:name="MainColumnFrontend.WindowsClientApplications_Applications_Main.Application_ID" title="Application_ID" width="50" source="Main" columnname="Main.Application_ID" titlealignment="None" />
					</quicklookup>
					<textbox bop:name="MainColumnApplications.Description" title="Description" nilifblank="False" width="35" source="Main" columnname="Applications.Description" readonly="True" />
				</row>
			</group>
			<textbox bop:name="MainColumnMain.ThemeDocument" title="Theme Document" nilifblank="False" source="Main" columnname="Main.ThemeDocument" />
			<textbox bop:name="MainColumnMain.DefaultIconImage" title="Default Form Icon Image" nilifblank="False" source="Main" columnname="Main.DefaultIconImage" />
			<numerictextbox bop:name="MainColumnMain.DocumentCacheSize" title="Document Cache Size" hint="0 = client-side document cache off" source="Main" columnname="Main.DocumentCacheSize" />
			<numerictextbox bop:name="MainColumnMain.ImageCacheSize" title="Image Cache Size" hint="0 = client-side image cache off" source="Main" columnname="Main.ImageCacheSize" />
			<textbox bop:name="MainColumnMain.HelpDocument" title="Help Document" nilifblank="False" source="Main" columnname="Main.HelpDocument" />
		</column>
	</column>
</interface>
