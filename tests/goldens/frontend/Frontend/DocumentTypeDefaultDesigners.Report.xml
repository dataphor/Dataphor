<report xmlns:bop="www.alphora.com/schemas/bop">
	<source bop:name="Main" expression="(&#xD;&#xA; (&#xD;&#xA;  Frontend.DocumentTypeDefaultDesigners&#xD;&#xA;   rename Main&#xD;&#xA; )&#xD;&#xA;  left lookup&#xD;&#xA;  (&#xD;&#xA;   (&#xD;&#xA;    Frontend.DocumentTypes&#xD;&#xA;     over { .ID, .Description }&#xD;&#xA;   )&#xD;&#xA;    rename DocumentTypes&#xD;&#xA;  )&#xD;&#xA;  by (.Main.DocumentType_ID = .DocumentTypes.ID)&#xD;&#xA;)&#xD;&#xA; browse by { Main.DocumentType_ID asc include nil }&#xD;&#xA;capabilities { navigable, backwardsnavigable, bookmarkable, searchable, updateable }&#xD;&#xA;isolation browse" />
	<header bop:name="PageHeader" height="15">
		<textarea bop:name="ReportName" text="Document Type Default Designers Report" y="0" />
		<date bop:name="HeaderDate" x="520" y="0" />
	</header>
	<databand bop:name="RootDataBand" source="Main">
		<header bop:name="RootDataBandHeader">
			<box bop:name="RootDataBandHeaderBox" height="11" width="600" x="5" y="2" />
			<textarea bop:name="MainColumnDocumentType_IDHeader" text="Document Type" x="10" y="3" maxlength="40" />
			<textarea bop:name="MainColumnDefault_Designer_IDHeader" text="Default Designer" x="210" y="3" maxlength="40" />
		</header>
		<staticgroup bop:name="RootDataBandContent">
			<field bop:name="MainColumnDocumentType_ID" source="Main" columnname="DocumentType_ID" x="10" maxlength="40" />
			<field bop:name="MainColumnDefault_Designer_ID" source="Main" columnname="Default_Designer_ID" x="210" maxlength="40" />
		</staticgroup>
	</databand>
	<footer bop:name="PageFooter" height="20">
		<textarea bop:name="PageFooterPageText" text="Page" x="290" y="5" />
		<pagenumber bop:name="PageFooterPageNumber" x="310" y="5" />
	</footer>
</report>
