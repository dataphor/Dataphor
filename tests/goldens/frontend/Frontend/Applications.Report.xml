<report xmlns:bop="www.alphora.com/schemas/bop">
	<source bop:name="Main" expression="(&#xD;&#xA; Frontend.Applications&#xD;&#xA;  rename Main&#xD;&#xA;)&#xD;&#xA; browse by { Main.ID asc include nil }&#xD;&#xA;capabilities { navigable, backwardsnavigable, bookmarkable, searchable, updateable }&#xD;&#xA;isolation browse" />
	<header bop:name="PageHeader" height="15">
		<textarea bop:name="ReportName" text="Applications Report" y="0" />
		<date bop:name="HeaderDate" x="520" y="0" />
	</header>
	<databand bop:name="RootDataBand" source="Main">
		<header bop:name="RootDataBandHeader">
			<box bop:name="RootDataBandHeaderBox" height="11" width="600" x="5" y="2" />
			<textarea bop:name="MainColumnIDHeader" text="ID" x="10" y="3" maxlength="25" />
			<textarea bop:name="MainColumnDescriptionHeader" text="Description" x="135" y="3" maxlength="35" />
			<textarea bop:name="MainColumnStartDocumentHeader" text="Start Document" x="310" y="3" maxlength="40" />
		</header>
		<staticgroup bop:name="RootDataBandContent">
			<field bop:name="MainColumnID" source="Main" columnname="ID" x="10" maxlength="25" />
			<field bop:name="MainColumnDescription" source="Main" columnname="Description" x="135" maxlength="35" />
			<field bop:name="MainColumnStartDocument" source="Main" columnname="StartDocument" x="310" maxlength="40" />
		</staticgroup>
	</databand>
	<footer bop:name="PageFooter" height="20">
		<textarea bop:name="PageFooterPageText" text="Page" x="290" y="5" />
		<pagenumber bop:name="PageFooterPageNumber" x="310" y="5" />
	</footer>
</report>
