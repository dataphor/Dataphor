<interface xmlns:bop="www.alphora.com/schemas/bop" text="Edit Application Libraries" mainsource="Main">
	<source bop:name="Main" expression="(&#xD;&#xA; (&#xD;&#xA;  Frontend.ApplicationLibraries&#xD;&#xA;   rename Main&#xD;&#xA; )&#xD;&#xA;  left lookup&#xD;&#xA;  (&#xD;&#xA;   (&#xD;&#xA;    Frontend.Applications&#xD;&#xA;     over { .ID, .Description }&#xD;&#xA;   )&#xD;&#xA;    rename Applications&#xD;&#xA;  )&#xD;&#xA;  by (.Main.Application_ID = .Applications.ID)&#xD;&#xA;)&#xD;&#xA; browse by { Main.Application_ID asc include nil, Main.Library_Name asc include nil }&#xD;&#xA;capabilities { navigable, backwardsnavigable, bookmarkable, searchable, updateable }&#xD;&#xA;isolation browse" />
	<showformaction bop:name="Main.Application_ID.Frontend.ApplicationLibraries_Applications" text="Application..." document=".Frontend.Derive('Frontend.Applications', 'View', '', '', true)" sourcelinktype="Detail" sourcelink.source="Main" sourcelink.masterkeynames="Main.Application_ID" sourcelink.detailkeynames="Main.ID" sourcelinkrefresh="False" />
	<showformaction bop:name="Main.Library_Name.Frontend.ApplicationLibraries_Libraries" text="Library..." document=".Frontend.Derive('System.Libraries', 'View', '', '', true)" sourcelinktype="Detail" sourcelink.source="Main" sourcelink.masterkeynames="Main.Library_Name" sourcelink.detailkeynames="Main.Name" sourcelinkrefresh="False" />
	<menu bop:name="LookupViewMenuItem" text="Vie&amp;w">
		<menu bop:name="Main.Application_ID.Frontend.ApplicationLibraries_ApplicationsLookupMenuItem" action="Main.Application_ID.Frontend.ApplicationLibraries_Applications" />
		<menu bop:name="Main.Library_Name.Frontend.ApplicationLibraries_LibrariesLookupMenuItem" action="Main.Library_Name.Frontend.ApplicationLibraries_Libraries" />
	</menu>
	<sourceaction bop:name="Validate" source="Main" text="&amp;Validate" action="Validate" />
	<column bop:name="RootEditColumn">
		<column bop:name="Element1">
			<fulllookup bop:name="Main.Application_ID.Frontend.ApplicationLibraries_ApplicationsGroup" title="Application" source="Main" columnnames="Main.Application_ID" lookupcolumnnames="Main.ID" document=".Frontend.Derive('Frontend.Applications', 'Browse', '', '', true)">
				<column bop:name="Element2">
					<textbox bop:name="MainColumnFrontend.ApplicationLibraries_Applications_Main.Application_ID" title="Application_ID" width="50" source="Main" columnname="Main.Application_ID" />
					<textbox bop:name="MainColumnApplications.Description" title="Description" nilifblank="False" width="35" source="Main" columnname="Applications.Description" readonly="True" />
				</column>
			</fulllookup>
			<quicklookup bop:name="MainColumnFrontend.ApplicationLibraries_Libraries_Main.Library_Name_Lookup" title="Library Name" source="Main" columnname="Main.Library_Name" lookupcolumnname="Main.Name" document=".Frontend.Derive('System.Libraries', 'Browse', '', '', true)">
				<textbox bop:name="MainColumnFrontend.ApplicationLibraries_Libraries_Main.Library_Name" title="Library Name" width="50" source="Main" columnname="Main.Library_Name" titlealignment="None" />
			</quicklookup>
		</column>
	</column>
</interface>
