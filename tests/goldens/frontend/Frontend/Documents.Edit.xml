<interface xmlns:bop="www.alphora.com/schemas/bop" text="Edit Documents" mainsource="Main">
	<source bop:name="Main" expression="(&#xD;&#xA; (&#xD;&#xA;  Frontend.Documents&#xD;&#xA;   rename Main&#xD;&#xA; )&#xD;&#xA;  left lookup&#xD;&#xA;  (&#xD;&#xA;   (&#xD;&#xA;    Frontend.DocumentTypes&#xD;&#xA;     over { .ID, .Description }&#xD;&#xA;   )&#xD;&#xA;    rename DocumentTypes&#xD;&#xA;  )&#xD;&#xA;  by (.Main.Type_ID = .DocumentTypes.ID)&#xD;&#xA;)&#xD;&#xA; browse by { Main.Library_Name asc include nil, Main.Name asc include nil }&#xD;&#xA;capabilities { navigable, backwardsnavigable, bookmarkable, searchable, updateable }&#xD;&#xA;isolation browse" />
	<showformaction bop:name="Main.Library_Name.Frontend.Documents_Libraries" text="Library..." document=".Frontend.Derive('System.Libraries', 'View', '', '', true)" sourcelinktype="Detail" sourcelink.source="Main" sourcelink.masterkeynames="Main.Library_Name" sourcelink.detailkeynames="Main.Name" sourcelinkrefresh="False" />
	<showformaction bop:name="Main.Type_ID.Frontend.Documents_DocumentTypes" text="Document Type..." document=".Frontend.Derive('Frontend.DocumentTypes', 'View', '', '', true)" sourcelinktype="Detail" sourcelink.source="Main" sourcelink.masterkeynames="Main.Type_ID" sourcelink.detailkeynames="Main.ID" sourcelinkrefresh="False" />
	<menu bop:name="LookupViewMenuItem" text="Vie&amp;w">
		<menu bop:name="Main.Library_Name.Frontend.Documents_LibrariesLookupMenuItem" action="Main.Library_Name.Frontend.Documents_Libraries" />
		<menu bop:name="Main.Type_ID.Frontend.Documents_DocumentTypesLookupMenuItem" action="Main.Type_ID.Frontend.Documents_DocumentTypes" />
	</menu>
	<sourceaction bop:name="Validate" source="Main" text="&amp;Validate" action="Validate" />
	<column bop:name="RootEditColumn">
		<column bop:name="Element1">
			<quicklookup bop:name="MainColumnFrontend.Documents_Libraries_Main.Library_Name_Lookup" title="Library Name" source="Main" columnname="Main.Library_Name" lookupcolumnname="Main.Name" document=".Frontend.Derive('System.Libraries', 'Browse', '', '', true)">
				<textbox bop:name="MainColumnFrontend.Documents_Libraries_Main.Library_Name" title="Library Name" width="50" source="Main" columnname="Main.Library_Name" titlealignment="None" />
			</quicklookup>
			<textbox bop:name="MainColumnMain.Name" title="Name" nilifblank="False" width="50" source="Main" columnname="Main.Name" />
			<group bop:name="Main.Type_ID.Frontend.Documents_DocumentTypesGroup" title="Document Type">
				<row bop:name="Element2">
					<quicklookup bop:name="MainColumnFrontend.Documents_DocumentTypes_Main.Type_ID_Lookup" title="Document Type" source="Main" columnname="Main.Type_ID" lookupcolumnname="Main.ID" document=".Frontend.Derive('Frontend.DocumentTypes', 'Browse', '', '', true)" readonly="True">
						<textbox bop:name="MainColumnFrontend.Documents_DocumentTypes_Main.Type_ID" title="Document Type" source="Main" columnname="Main.Type_ID" readonly="True" titlealignment="None" />
					</quicklookup>
					<textbox bop:name="MainColumnDocumentTypes.Description" title="Description" nilifblank="False" width="35" source="Main" columnname="DocumentTypes.Description" readonly="True" />
				</row>
			</group>
		</column>
	</column>
</interface>
