<report xmlns:bop="www.alphora.com/schemas/bop">
	<source bop:name="Main" expression="(&#xD;&#xA; Sample.Forms.Customer&#xD;&#xA;  rename Main&#xD;&#xA;)&#xD;&#xA; browse by { Main.ID asc include nil }&#xD;&#xA;capabilities { navigable, backwardsnavigable, bookmarkable, searchable, updateable }&#xD;&#xA;isolation browse" />
	<header bop:name="PageHeader" height="15">
		<textarea bop:name="ReportName" text="Customer Report" y="0" />
		<date bop:name="HeaderDate" x="520" y="0" />
	</header>
	<databand bop:name="RootDataBand" source="Main">
		<header bop:name="RootDataBandHeader">
			<box bop:name="RootDataBandHeaderBox" height="11" width="600" x="5" y="2" />
			<textarea bop:name="MainColumnIDHeader" text="ID" x="10" y="3" maxlength="40" />
			<textarea bop:name="MainColumnNameHeader" text="Name" x="210" y="3" maxlength="40" />
			<textarea bop:name="MainColumnPhoneHeader" text="Phone" x="410" y="3" maxlength="40" />
			<textarea bop:name="MainColumnAddressHeader" text="Address" x="610" y="3" maxlength="40" />
			<textarea bop:name="MainColumnCityHeader" text="City" x="810" y="3" maxlength="40" />
			<textarea bop:name="MainColumnStateHeader" text="State" x="1010" y="3" maxlength="40" />
			<textarea bop:name="MainColumnZipHeader" text="Zip" x="1210" y="3" maxlength="40" />
		</header>
		<staticgroup bop:name="RootDataBandContent">
			<field bop:name="MainColumnID" source="Main" columnname="ID" x="10" maxlength="40" />
			<field bop:name="MainColumnName" source="Main" columnname="Name" x="210" maxlength="40" />
			<field bop:name="MainColumnPhone" source="Main" columnname="Phone" x="410" maxlength="40" />
			<field bop:name="MainColumnAddress" source="Main" columnname="Address" x="610" maxlength="40" />
			<field bop:name="MainColumnCity" source="Main" columnname="City" x="810" maxlength="40" />
			<field bop:name="MainColumnState" source="Main" columnname="State" x="1010" maxlength="40" />
			<field bop:name="MainColumnZip" source="Main" columnname="Zip" x="1210" maxlength="40" />
		</staticgroup>
	</databand>
	<footer bop:name="PageFooter" height="20">
		<textarea bop:name="PageFooterPageText" text="Page" x="290" y="5" />
		<pagenumber bop:name="PageFooterPageNumber" x="310" y="5" />
	</footer>
</report>
