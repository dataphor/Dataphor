<report xmlns:bop="www.alphora.com/schemas/bop">
	<source bop:name="Main" expression="(&#xD;&#xA; Sample.IssueTracker.Employee&#xD;&#xA;  rename Main&#xD;&#xA;)&#xD;&#xA; browse by { Main.ID asc include nil }&#xD;&#xA;capabilities { navigable, backwardsnavigable, bookmarkable, searchable, updateable }&#xD;&#xA;isolation browse" />
	<header bop:name="PageHeader" height="15">
		<textarea bop:name="ReportName" text="Employee Report" y="0" />
		<date bop:name="HeaderDate" x="520" y="0" />
	</header>
	<databand bop:name="RootDataBand" source="Main">
		<header bop:name="RootDataBandHeader">
			<box bop:name="RootDataBandHeaderBox" height="11" width="600" x="5" y="2" />
			<textarea bop:name="MainColumnIDHeader" text="Employee ID" x="10" y="3" maxlength="4" />
			<textarea bop:name="MainColumnDepartment_IDHeader" text="Department ID" x="30" y="3" maxlength="4" />
			<textarea bop:name="MainColumnNameHeader" text="Name" x="50" y="3" maxlength="30" />
		</header>
		<staticgroup bop:name="RootDataBandContent">
			<field bop:name="MainColumnID" source="Main" columnname="ID" x="10" maxlength="4" />
			<field bop:name="MainColumnDepartment_ID" source="Main" columnname="Department_ID" x="30" maxlength="4" />
			<field bop:name="MainColumnName" source="Main" columnname="Name" x="50" maxlength="30" />
		</staticgroup>
	</databand>
	<footer bop:name="PageFooter" height="20">
		<textarea bop:name="PageFooterPageText" text="Page" x="290" y="5" />
		<pagenumber bop:name="PageFooterPageNumber" x="310" y="5" />
	</footer>
</report>
