<interface xmlns:bop="www.alphora.com/schemas/bop" text="List Issue" mainsource="Main">
	<source bop:name="Main" expression="(&#xD;&#xA; Sample.IssueTracker.Issue&#xD;&#xA;  rename Main&#xD;&#xA;)&#xD;&#xA; browse by { Main.Product_ID asc, Main.Version asc, Main.Priority asc }&#xD;&#xA;capabilities { navigable, backwardsnavigable, bookmarkable, searchable, updateable }&#xD;&#xA;isolation browse" isreadonly="True" />
	<showformaction bop:name="Main.ID.Sample.IssueTracker.Action_Issue" text="Action..." document=".Frontend.Derive('Sample.IssueTracker.Action', 'Browse', 'Main.ID', 'Main.Issue_ID', true)" sourcelinktype="Detail" sourcelink.source="Main" sourcelink.masterkeynames="Main.ID" sourcelink.detailkeynames="Main.Issue_ID" sourcelinkrefresh="False" />
	<menu bop:name="DetailsMenuItem" text="De&amp;tails">
		<menu bop:name="Main.ID.Sample.IssueTracker.Action_IssueDetailsMenuItem" action="Main.ID.Sample.IssueTracker.Action_Issue" />
	</menu>
	<showformaction bop:name="Main.Product_ID.Sample.IssueTracker.Issue_Product" text="Product..." document=".Frontend.Derive('Sample.IssueTracker.Product', 'View', '', '', true)" sourcelinktype="Detail" sourcelink.source="Main" sourcelink.masterkeynames="Main.Product_ID" sourcelink.detailkeynames="Main.ID" sourcelinkrefresh="False" />
	<menu bop:name="LookupViewMenuItem" text="Vie&amp;w">
		<menu bop:name="Main.Product_ID.Sample.IssueTracker.Issue_ProductLookupMenuItem" action="Main.Product_ID.Sample.IssueTracker.Issue_Product" />
	</menu>
	<sourceaction bop:name="MoveFirst" source="Main" text="&amp;First" action="First" image="Image('Frontend', 'Image.First')" />
	<sourceaction bop:name="MovePrior" source="Main" text="&amp;Prior" action="Prior" image="Image('Frontend', 'Image.Prior')" />
	<sourceaction bop:name="MoveNext" source="Main" text="&amp;Next" action="Next" image="Image('Frontend', 'Image.Next')" />
	<sourceaction bop:name="MoveLast" source="Main" text="&amp;Last" action="Last" image="Image('Frontend', 'Image.Last')" />
	<sourceaction bop:name="Refresh" source="Main" text="&amp;Refresh" action="Refresh" image="Image('Frontend', 'Image.Refresh')" />
	<menu bop:name="NavigationMenu" text="&amp;Navigation">
		<menu bop:name="MoveFirstMenu" action="MoveFirst" />
		<menu bop:name="MovePriorMenu" action="MovePrior" />
		<menu bop:name="MoveNextMenu" action="MoveNext" />
		<menu bop:name="MoveLastMenu" action="MoveLast" />
		<menu bop:name="NavSepMenu1" text="-" />
		<menu bop:name="RefreshMenu" action="Refresh" />
	</menu>
	<column bop:name="RootBrowseColumn">
		<search bop:name="MainSearch" hint="Search for a specific row." source="Main">
			<searchcolumn bop:name="MainSearchColumnMain.Product_ID" title="Product ID" hint="Identifier of the product involved" width="4" columnname="Main.Product_ID" />
			<searchcolumn bop:name="MainSearchColumnMain.Version" title="Version" hint="The version of the product" width="11" columnname="Main.Version" />
			<searchcolumn bop:name="MainSearchColumnMain.Priority" title="Priority" hint="Numeric priority (0 = Highest)" width="20" columnname="Main.Priority" />
			<searchcolumn bop:name="MainSearchColumnMain.Description" title="Description" hint="Complete description of the problem" width="50" columnname="Main.Description" />
			<searchcolumn bop:name="MainSearchColumnMain.ID" title="Issue ID" hint="Issue Identification #" width="10" columnname="Main.ID" />
		</search>
		<row bop:name="GridRow">
			<grid bop:name="Grid" hint="Issue" source="Main">
				<textcolumn bop:name="MainGridColumnSample.IssueTracker.Issue_Product_Main.Product_ID" title="Product ID" hint="Identifier of the product involved" width="4" columnname="Main.Product_ID" />
				<textcolumn bop:name="MainGridColumnMain.Version" title="Version" hint="The version of the product" width="11" columnname="Main.Version" />
				<textcolumn bop:name="MainGridColumnMain.Priority" title="Priority" hint="Numeric priority (0 = Highest)" width="20" columnname="Main.Priority" />
				<textcolumn bop:name="MainGridColumnMain.Description" title="Description" hint="Complete description of the problem" width="50" columnname="Main.Description" />
				<textcolumn bop:name="MainGridColumnMain.ReproductionSteps" title="Steps To Reproduce" hint="Steps necessary to reproduce the issue" width="50" columnname="Main.ReproductionSteps" />
			</grid>
		</row>
		<notebook bop:name="MainEmbeddedDetailsNotebook">
			<notebookframepage bop:name="Sample.IssueTracker.Action_IssueFrame" document=".Frontend.Derive('Sample.IssueTracker.Action', 'Browse', 'Main.ID', 'Main.Issue_ID', true)" sourcelinktype="Detail" sourcelink.source="Main" sourcelink.masterkeynames="Main.ID" sourcelink.detailkeynames="Main.Issue_ID" menutext="Action" title="Action" />
		</notebook>
	</column>
</interface>
