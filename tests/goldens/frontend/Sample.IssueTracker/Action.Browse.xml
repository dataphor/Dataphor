<interface xmlns:bop="www.alphora.com/schemas/bop" text="Browse Action" mainsource="Main" OnDefault="Edit">
	<source bop:name="Main" expression="(&#xD;&#xA; Sample.IssueTracker.Action&#xD;&#xA;  rename Main&#xD;&#xA;)&#xD;&#xA; browse by { Main.Issue_ID asc include nil, Main.ID asc include nil }&#xD;&#xA;capabilities { navigable, backwardsnavigable, bookmarkable, searchable, updateable }&#xD;&#xA;isolation browse" />
	<showformaction bop:name="Main.Issue_ID.Main.ID.Sample.IssueTracker.ActionDetail_Action" text="Action Detail..." document=".Frontend.Derive('Sample.IssueTracker.ActionDetail', 'Edit', 'Main.Issue_ID,Main.ID', 'Main.Issue_ID,Main.Action_ID', true)" sourcelinktype="Detail" sourcelink.source="Main" sourcelink.masterkeynames="Main.Issue_ID,Main.ID" sourcelink.detailkeynames="Main.Issue_ID,Main.Action_ID" mode="Edit" sourcelinkrefresh="False" />
	<menu bop:name="ExtensionsMenuItem" text="E&amp;xtensions">
		<menu bop:name="Main.Issue_ID.Main.ID.Sample.IssueTracker.ActionDetail_ActionExtensionsMenuItem" action="Main.Issue_ID.Main.ID.Sample.IssueTracker.ActionDetail_Action" />
	</menu>
	<exposed bop:name="Main.Issue_ID.Main.ID.Sample.IssueTracker.ActionDetail_ActionExtensionsExposed" action="Main.Issue_ID.Main.ID.Sample.IssueTracker.ActionDetail_Action" />
	<showformaction bop:name="Main.Issue_ID.Sample.IssueTracker.Action_Issue" text="Issue..." document=".Frontend.Derive('Sample.IssueTracker.Issue', 'View', '', '', true)" sourcelinktype="Detail" sourcelink.source="Main" sourcelink.masterkeynames="Main.Issue_ID" sourcelink.detailkeynames="Main.ID" sourcelinkrefresh="False" />
	<showformaction bop:name="Main.State_ID.Sample.IssueTracker.Issue_State" text="State..." document=".Frontend.Derive('Sample.IssueTracker.State', 'View', '', '', true)" sourcelinktype="Detail" sourcelink.source="Main" sourcelink.masterkeynames="Main.State_ID" sourcelink.detailkeynames="Main.ID" sourcelinkrefresh="False" />
	<showformaction bop:name="Main.AssigneeEmployee_ID.Sample.IssueTracker.Issue_Assignee_Employee" text="Employee..." document=".Frontend.Derive('Sample.IssueTracker.Employee', 'View', '', '', true)" sourcelinktype="Detail" sourcelink.source="Main" sourcelink.masterkeynames="Main.AssigneeEmployee_ID" sourcelink.detailkeynames="Main.ID" sourcelinkrefresh="False" />
	<menu bop:name="LookupViewMenuItem" text="Vie&amp;w">
		<menu bop:name="Main.Issue_ID.Sample.IssueTracker.Action_IssueLookupMenuItem" action="Main.Issue_ID.Sample.IssueTracker.Action_Issue" />
		<menu bop:name="Main.State_ID.Sample.IssueTracker.Issue_StateLookupMenuItem" action="Main.State_ID.Sample.IssueTracker.Issue_State" />
		<menu bop:name="Main.AssigneeEmployee_ID.Sample.IssueTracker.Issue_Assignee_EmployeeLookupMenuItem" action="Main.AssigneeEmployee_ID.Sample.IssueTracker.Issue_Assignee_Employee" />
	</menu>
	<showformaction bop:name="Add" text="&amp;Add..." document=".Frontend.Derive('Sample.IssueTracker.Action', 'Add', '', '', true)" mode="Insert" sourcelinktype="Detail" sourcelink.source="Main" hint="Add a new row." image="Image('Frontend', 'Image.Add')" />
	<showformaction bop:name="Edit" text="&amp;Edit..." document=".Frontend.Derive('Sample.IssueTracker.Action', 'Edit', '', '', true)" mode="Edit" sourcelinktype="Detail" sourcelink.source="Main" sourcelink.masterkeynames="Main.Issue_ID, Main.ID" sourcelink.detailkeynames="Main.Issue_ID, Main.ID" hint="Edit the current row." image="Image('Frontend', 'Image.Edit')" />
	<showformaction bop:name="Delete" text="&amp;Delete..." document=".Frontend.Derive('Sample.IssueTracker.Action', 'Delete', '', '', true)" mode="Delete" sourcelinktype="Detail" sourcelink.source="Main" sourcelink.masterkeynames="Main.Issue_ID, Main.ID" sourcelink.detailkeynames="Main.Issue_ID, Main.ID" hint="Delete the current row." image="Image('Frontend', 'Image.Delete')" />
	<showformaction bop:name="View" text="&amp;View..." document=".Frontend.Derive('Sample.IssueTracker.Action', 'View', '', '', true)" sourcelinktype="Detail" sourcelink.source="Main" sourcelink.masterkeynames="Main.Issue_ID, Main.ID" sourcelink.detailkeynames="Main.Issue_ID, Main.ID" hint="View the current row." image="Image('Frontend', 'Image.View')" />
	<sourceaction bop:name="MoveFirst" source="Main" text="&amp;First" action="First" image="Image('Frontend', 'Image.First')" />
	<sourceaction bop:name="MovePrior" source="Main" text="&amp;Prior" action="Prior" image="Image('Frontend', 'Image.Prior')" />
	<sourceaction bop:name="MoveNext" source="Main" text="&amp;Next" action="Next" image="Image('Frontend', 'Image.Next')" />
	<sourceaction bop:name="MoveLast" source="Main" text="&amp;Last" action="Last" image="Image('Frontend', 'Image.Last')" />
	<sourceaction bop:name="Refresh" source="Main" text="&amp;Refresh" action="Refresh" image="Image('Frontend', 'Image.Refresh')" />
	<menu bop:name="NavigationMenu" text="&amp;Navigation">
		<menu bop:name="MoveFirstMenu" action="MoveFirst" />
		<menu bop:name="MovePriorMenu" action="MovePrior" />
		<menu bop:name="MoveNextMenu" action="MoveNext" />
		<menu bop:name="MoveLastMenu" action="MoveLast" />
		<menu bop:name="NavSepMenu1" text="-" />
		<menu bop:name="RefreshMenu" action="Refresh" />
	</menu>
	<column bop:name="RootBrowseColumn">
		<search bop:name="MainSearch" hint="Search for a specific row." source="Main">
			<searchcolumn bop:name="MainSearchColumnMain.Issue_ID" title="Issue ID" hint="Issue Identification #" width="10" columnname="Main.Issue_ID" />
			<searchcolumn bop:name="MainSearchColumnMain.ID" title="Action ID" hint="Action Identification #" width="10" columnname="Main.ID" />
		</search>
		<row bop:name="GridRow">
			<grid bop:name="Grid" hint="Action" source="Main">
				<textcolumn bop:name="MainGridColumnSample.IssueTracker.Action_Issue_Main.Issue_ID" title="Issue ID" hint="Issue Identification #" width="10" columnname="Main.Issue_ID" />
				<textcolumn bop:name="MainGridColumnMain.ID" title="Action ID" hint="Action Identification #" width="10" columnname="Main.ID" />
				<textcolumn bop:name="MainGridColumnMain.DateTime" title="Date/Time" hint="Date/time the action occured" width="20" columnname="Main.DateTime" />
				<textcolumn bop:name="MainGridColumnSample.IssueTracker.Issue_State_Main.State_ID" title="New State" hint="The state of the issue after this action" width="4" columnname="Main.State_ID" />
				<textcolumn bop:name="MainGridColumnSample.IssueTracker.Issue_Assignee_Employee_Main.AssigneeEmployee_ID" title="New Assignee" hint="The Employee assigned to this issue after this action" width="4" columnname="Main.AssigneeEmployee_ID" />
				<textcolumn bop:name="MainGridColumnMain.Notes" title="Notes" hint="Notes about the action taken" width="50" columnname="Main.Notes" />
			</grid>
			<column bop:name="GridBar">
				<trigger bop:name="AddTrigger" action="Add" imagewidth="11" imageheight="13" />
				<trigger bop:name="EditTrigger" action="Edit" imagewidth="11" imageheight="13" />
				<trigger bop:name="DeleteTrigger" action="Delete" imagewidth="11" imageheight="13" />
				<trigger bop:name="ViewTrigger" action="View" imagewidth="11" imageheight="13" />
			</column>
		</row>
	</column>
</interface>
