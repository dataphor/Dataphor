<report xmlns:bop="www.alphora.com/schemas/bop">
	<source bop:name="Main" expression="(&#xD;&#xA; Sample.IssueTracker.ActionDetail&#xD;&#xA;  rename Main&#xD;&#xA;)&#xD;&#xA; browse by { Main.Issue_ID asc include nil, Main.Action_ID asc include nil }&#xD;&#xA;capabilities { navigable, backwardsnavigable, bookmarkable, searchable, updateable }&#xD;&#xA;isolation browse" />
	<header bop:name="PageHeader" height="15">
		<textarea bop:name="ReportName" text="Action Detail Report" y="0" />
		<date bop:name="HeaderDate" x="520" y="0" />
	</header>
	<databand bop:name="RootDataBand" source="Main">
		<header bop:name="RootDataBandHeader">
			<box bop:name="RootDataBandHeaderBox" height="11" width="600" x="5" y="2" />
			<textarea bop:name="MainColumnIssue_IDHeader" text="Issue ID" x="10" y="3" maxlength="10" />
			<textarea bop:name="MainColumnAction_IDHeader" text="Action ID" x="60" y="3" maxlength="10" />
			<textarea bop:name="MainColumnSoftwareEnvironmentHeader" text="Software Environment" x="110" y="3" maxlength="40" />
			<textarea bop:name="MainColumnHardwareEnvironmentHeader" text="Hardware Environment" x="310" y="3" maxlength="40" />
		</header>
		<staticgroup bop:name="RootDataBandContent">
			<field bop:name="MainColumnIssue_ID" source="Main" columnname="Issue_ID" x="10" maxlength="10" />
			<field bop:name="MainColumnAction_ID" source="Main" columnname="Action_ID" x="60" maxlength="10" />
			<field bop:name="MainColumnSoftwareEnvironment" source="Main" columnname="SoftwareEnvironment" x="110" maxlength="40" />
			<field bop:name="MainColumnHardwareEnvironment" source="Main" columnname="HardwareEnvironment" x="310" maxlength="40" />
		</staticgroup>
	</databand>
	<footer bop:name="PageFooter" height="20">
		<textarea bop:name="PageFooterPageText" text="Page" x="290" y="5" />
		<pagenumber bop:name="PageFooterPageNumber" x="310" y="5" />
	</footer>
</report>
