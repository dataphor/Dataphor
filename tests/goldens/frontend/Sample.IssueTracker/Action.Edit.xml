			<quicklookup bop:name="MainColumnSample.IssueTracker.Action_Issue_Main.Issue_ID_Lookup" title="Issue ID" source="Main" columnname="Main.Issue_ID" lookupcolumnname="Main.ID" document=".Frontend.Derive('Sample.IssueTracker.Issue', 'Browse', '', '', true)">
