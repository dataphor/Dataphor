			</quicklookup>
			<datetimebox bop:name="MainColumnMain.DateTime" title="Date/Time" hint="Date/time the action occured" source="Main" columnname="Main.DateTime" />
			<quicklookup bop:name="MainColumnSample.IssueTracker.Issue_State_Main.State_ID_Lookup" title="New State" source="Main" columnname="Main.State_ID" lookupcolumnname="Main.ID" document=".Frontend.Derive('Sample.IssueTracker.State', 'Browse', '', '', true)">
