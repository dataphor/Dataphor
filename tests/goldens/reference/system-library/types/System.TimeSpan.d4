create type .System.TimeSpan class "System.TimeSpanConveyor" static tags { Catalog.Comment = "System Time Span", DAE.AsString = "AsString" };
alter type System.TimeSpan
{
	create representation Ticks
	{
		Ticks : System.Long
			read  class "System.SystemTimeSpanTicksReadTicksNode"
			write  class "System.SystemTimeSpanTicksWriteTicksNode"
	}selector  class "System.SystemTimeSpanTicksSelectorNode"
};
alter type System.TimeSpan
{
	create representation Milliseconds
	{
		Milliseconds : System.Decimal
			read  class "System.SystemTimeSpanMillisecondsReadMillisecondsNode"
			write  class "System.SystemTimeSpanMillisecondsWriteMillisecondsNode"
	}selector  class "System.SystemTimeSpanMillisecondsSelectorNode"
};
alter type System.TimeSpan
{
	create representation Seconds
	{
		Seconds : System.Decimal
			read  class "System.SystemTimeSpanSecondsReadSecondsNode"
			write  class "System.SystemTimeSpanSecondsWriteSecondsNode"
	}selector  class "System.SystemTimeSpanSecondsSelectorNode"
};
alter type System.TimeSpan
{
	create representation Minutes
	{
		Minutes : System.Decimal
			read  class "System.SystemTimeSpanMinutesReadMinutesNode"
			write  class "System.SystemTimeSpanMinutesWriteMinutesNode"
	}selector  class "System.SystemTimeSpanMinutesSelectorNode"
};
alter type System.TimeSpan
{
	create representation Hours
	{
		Hours : System.Decimal
			read  class "System.SystemTimeSpanHoursReadHoursNode"
