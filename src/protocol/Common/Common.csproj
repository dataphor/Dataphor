<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>AlphoraDataphorCommon</AssemblyName>
    <RootNamespace>Alphora.Dataphor.DAE</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!-- Constants: the legacy Release set without SIGNASSEMBLIES (signing is set in Directory.Build.props) in both configurations, plus DEBUG;TRACE in Debug as legacy Debug had them. Set outright; see Directory.Build.props. -->
  <PropertyGroup>
    <DefineConstants>TRACE</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceModel.Http" />
    <PackageReference Include="System.ServiceModel.NetTcp" />
    <PackageReference Include="System.ServiceModel.Primitives" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Contracts\DataphorServiceClient.cs" />
    <Compile Include="Contracts\DataphorServiceUtility.cs" />
    <Compile Include="Contracts\IClientListenerService.cs" />
    <Compile Include="Contracts\ListenerFault.cs" />
    <Compile Include="Contracts\ListenerFaultUtility.cs" />
    <Compile Include="Listener\ListenerClient.cs" />
    <Compile Include="Listener\ListenerFactory.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="WCF\ChannelFactoryCache.cs" />
    <Compile Include="WCF\ChannelFactoryEntry.cs" />
    <Compile Include="WCF\ChannelFactoryWrapper.cs" />
    <Compile Include="WCF\ChannelHolder.cs" />
    <Compile Include="WCF\EndpointDescriptor.cs" />
    <Compile Include="WCF\ServiceClient.cs" />
  </ItemGroup>

</Project>
