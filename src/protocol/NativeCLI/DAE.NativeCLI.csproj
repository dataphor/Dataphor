<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Alphora.Dataphor.DAE.NativeCLI</AssemblyName>
    <RootNamespace>Alphora.Dataphor.DAE.NativeCLI</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!-- Constants: the legacy Release set without SIGNASSEMBLIES (signing comes with build-version-and-signing) in both configurations, plus DEBUG;TRACE in Debug as legacy Debug had them. Set outright; see Directory.Build.props. -->
  <PropertyGroup>
    <DefineConstants></DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="System.ServiceModel.Http" />
    <PackageReference Include="System.ServiceModel.NetTcp" />
    <PackageReference Include="System.ServiceModel.Primitives" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="IClientNativeCLIService.cs" />
    <Compile Include="NativeCLI.cs" />
    <Compile Include="NativeCLIFault.cs" />
    <Compile Include="NativeCLIFaultUtility.cs" />
    <Compile Include="NativeCLISession.cs" />
    <Compile Include="NativeCLIException.cs" />
    <Compile Include="NativeCLIHelper.cs" />
    <Compile Include="NativeSessionInfo.cs" />
    <Compile Include="NativeStructures.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="SecurityUtility.cs" />
  </ItemGroup>

</Project>
