<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>AlphoraDataphorServer</AssemblyName>
    <RootNamespace>Alphora.Dataphor.DAE</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!-- Constants: the legacy Release set without SIGNASSEMBLIES (signing is set in Directory.Build.props) in both configurations, plus DEBUG;TRACE in Debug. Set outright; see Directory.Build.props. -->
  <PropertyGroup>
    <DefineConstants>TRACE</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Base.Windows\Base.Windows.csproj" />
    <ProjectReference Include="..\Base\Base.csproj" />
    <ProjectReference Include="..\..\protocol\Common\Common.csproj" />
    <ProjectReference Include="..\..\protocol\NativeCLI\DAE.NativeCLI.csproj" />
    <ProjectReference Include="..\DAE\DAE.csproj" />
  </ItemGroup>

  <!--
    System.ServiceModel.Primitives: the service contracts in Contracts\ (ServiceContract, OperationContract,
    FaultContract), which are the declarations the client's channel factories bind against, so they stay on the
    client stack. CoreWCF.Primitives: the service *implementations* in Service\, which carry CoreWCF's
    ServiceBehavior attribute and throw CoreWCF's FaultException<T>; of each pair CoreWCF recognises only its own,
    while it converts the contract attributes itself (see "CoreWCF proof" under WS5 in docs/modernization-plan.md).
    Microsoft.Data.SqlClient: Connection\MSSQL*.cs, and Server\Server.cs, which clears that client's connection
    pools when a server is disposed. This is the repository's only SQL Server client reference that a shipped
    assembly needs; the catalog store in src\engine\Store.MSSQL takes it from here.
    NOTE: that client brings a larger closure than the System.Data.SqlClient it replaced - measured with the two host
    executables in the layout, bin\ went from 76 to 84 top-level files (142 to 163 in all) - and eight of the added
    assemblies exist for authentication methods nothing here uses: Microsoft.IdentityModel.JsonWebTokens, .Protocols,
    .Protocols.OpenIdConnect and System.IdentityModel.Tokens.Jwt are the Microsoft Entra ID path, which no Dataphor
    connection string asks for. They ship because they are in the package's dependency graph, not because anything
    loads them. If the installer's size or a deployment's dependency audit ever objects, the question to ask then is
    whether this client can be restored without them (NuGet has no supported way to prune a package's own dependencies,
    so the answer would be a trimming step in WS9's installer rather than a change here).
    The framework reference substitutes the in-box ASP.NET Core 10 assemblies for the Microsoft.AspNetCore.* 2.3.10
    packages CoreWCF.Primitives depends on, through NuGet's package-override mechanism. Without it both sets of those
    assemblies landed in the runtime layout's bin\, where a host would ship the unused 2.3.10 ones; measured
    (host-generic-host): with the two host executables in the layout, its bin\ holds 93 files without this
    reference and 74 with it - the Microsoft.AspNetCore.* 2.3.10 assemblies and the Microsoft.Extensions.* package
    copies all gone - and restore still reports no NU1xxx warning. The reference also provides
    System.Diagnostics.EventLog, which Server\Server.cs needs to write the Windows event log and which was a package
    reference here until the reference made NuGet report it as likely unnecessary (NU1510). This assembly therefore
    needs the ASP.NET Core shared runtime at run time, which every .NET SDK install provides - as it already did
    through the hosting assembly for anything that hosts a server.
  -->
  <ItemGroup>
    <PackageReference Include="CoreWCF.Primitives" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="System.ServiceModel.Primitives" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    The three WCF service classes - DataphorService, ListenerService and NativeCLIService - are compiled here,
    against CoreWCF's behaviour and fault types. The host classes are not in this assembly: they are in
    src/engine/Server.Hosting (assembly Alphora.Dataphor.DAE.Server.Hosting), because hosting needs CoreWCF.NetTcp
    and every project that references this one would inherit its package-audit warning; that project file records the
    measurement. Nothing compiled here references them; an in-process Server does not need any of this.
  -->
  <ItemGroup>
    <Compile Include="Contracts\IDataphorService.cs" />
    <Compile Include="Connection\DotNetCommand.cs" />
    <Compile Include="Connection\DotNetConnection.cs" />
    <Compile Include="Connection\DotNetCursor.cs" />
    <Compile Include="Connection\GenericDotNetConnection.cs" />
    <Compile Include="Connection\MSSQLCommand.cs" />
    <Compile Include="Connection\MSSQLConnection.cs" />
    <Compile Include="Connection\MSSQLServerCursor.cs" />
    <Compile Include="Contracts\IListenerService.cs" />
    <Compile Include="Contracts\INativeCLIService.cs" />
    <Compile Include="Device.Catalog\CatalogDevicePlan.cs" />
    <Compile Include="Device.Catalog\CatalogDeviceTable.cs" />
    <Compile Include="Device.Catalog\ServerCatalogDevice.cs" />
    <Compile Include="Device.Catalog\ServerCatalogDeviceSession.cs" />
    <Compile Include="Register.cs" />
    <Compile Include="Runtime.Instructions\CatalogNodes.cs" />
    <Compile Include="Runtime.Instructions\LibraryNodes.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Runtime.Instructions\SecurityNodes.cs" />
    <Compile Include="Runtime.Instructions\SystemNodes.cs" />
    <Compile Include="Schema\LibraryUtility.cs" />
    <Compile Include="Server\CatalogCache.cs" />
    <Compile Include="Server\InstanceManager.cs" />
    <Compile Include="Service\ListenerService.cs" />
    <Compile Include="NativeCLI\NativeCLIUtility.cs" />
    <Compile Include="NativeCLI\NativeMarshal.cs" />
    <Compile Include="NativeCLI\NativeCLIService.cs" />
    <Compile Include="NativeCLI\NativeServer.cs" />
    <Compile Include="NativeCLI\NativeSession.cs" />
    <Compile Include="Server\RemoteServer.cs" />
    <Compile Include="Server\RemoteServerBatch.cs" />
    <Compile Include="Server\RemoteServerConnection.cs" />
    <Compile Include="Server\RemoteServerCursor.cs" />
    <Compile Include="Server\RemoteServerObject.cs" />
    <Compile Include="Server\RemoteServerPlan.cs" />
    <Compile Include="Server\RemoteServerProcess.cs" />
    <Compile Include="Server\RemoteServerScript.cs" />
    <Compile Include="Server\RemoteServerSession.cs" />
    <Compile Include="Server\RemoteSessionImplementation.cs" />
    <Compile Include="Server\Server.cs" />
    <Compile Include="Server\ServerConfiguration.cs" />
    <Compile Include="Service\ConnectionManager.cs" />
    <Compile Include="Service\DataphorService.cs" />
    <Compile Include="Service\HandleManager.cs" />
    <Compile Include="Service\NativeSessionManager.cs" />
    <Compile Include="Streams\FileStreamProvider.cs" />
  </ItemGroup>

</Project>
