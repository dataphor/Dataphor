<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Alphora.Dataphor.DAE</AssemblyName>
    <RootNamespace>Alphora.Dataphor.DAE</RootNamespace>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Constants: the set 3.1 shipped, in both configurations, plus DEBUG;TRACE in Debug, so that a Debug
    build and its tests run the same code paths as the shipped engine. 3.1 was built and deployed in
    Release, whose set this is; the legacy Debug set also had ACCUMULATOR and USEVISIT, which users never
    ran. Dropped from the legacy Release set: SIGNASSEMBLIES (signing is set in Directory.Build.props)
    and DISABLE_PERFORMANCE_COUNTERS (no code reads it). Set outright; see Directory.Build.props.
  -->
  <PropertyGroup>
    <DefineConstants>USENATIVE;NATIVEROW;USEOBJECTVALIDATE;NILPROPOGATION</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">DEBUG;TRACE;USENATIVE;NATIVEROW;USEOBJECTVALIDATE;NILPROPOGATION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Base\Base.csproj" />
  </ItemGroup>

  <!-- NOTE: only for Engine.Dispose (Server\Engine.cs), which clears the SqlClient connection pools as 3.1 did; when the SQL Server code moves to Microsoft.Data.SqlClient (device-mssql-port), that call and this reference must follow it. -->
