<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Alphora.Dataphor</AssemblyName>
    <RootNamespace>Alphora.Dataphor</RootNamespace>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Constants: the legacy Release set without SIGNASSEMBLIES (signing is set in Directory.Build.props) in both configurations, plus DEBUG;TRACE in Debug as legacy Debug had them. Set outright; see Directory.Build.props. -->
  <PropertyGroup>
    <DefineConstants></DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyNameUtility.cs" />
    <Compile Include="BitArrayEqualityComparer.cs" />
    <Compile Include="BOP\Attributes.cs" />
    <Compile Include="BOP\Deserializer.cs" />
    <Compile Include="BOP\Persistence.cs" />
    <Compile Include="BOP\Structures.cs" />
    <Compile Include="IndexedDictionary.cs" />
    <Compile Include="ProperFraction.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Base.cs" />
    <Compile Include="BaseException.cs" />
    <Compile Include="BaseList.cs" />
    <Compile Include="BOP\BOPException.cs" />
    <Compile Include="BOP\Dilx.cs" />
    <Compile Include="BOP\Inheritance.cs" />
    <Compile Include="BOP\Serializer.cs" />
    <Compile Include="BOP\Settings.cs" />
    <Compile Include="ByteArrayUtility.cs" />
    <Compile Include="CRC32.cs" />
    <Compile Include="DataphorException.cs" />
    <Compile Include="DisposableList.cs" />
    <Compile Include="ExceptionUtility.cs" />
    <Compile Include="FixedSizeCache.cs" />
    <Compile Include="ReferenceEqualityComparer.cs" />
    <Compile Include="Set.cs" />
    <Compile Include="MemoryUtility.cs" />
    <Compile Include="NonNullList.cs" />
    <Compile Include="NotifyingBaseList.cs" />
    <Compile Include="TemporaryStream.cs" />
    <Compile Include="IndexList.cs" />
    <Compile Include="ReflectionUtility.cs" />
    <Compile Include="StreamUtility.cs" />
    <Compile Include="ThreadUtility.cs" />
    <Compile Include="TimingUtility.cs" />
    <Compile Include="ValidatingBaseList.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Base.resx" DependentUpon="Base.cs" />
    <EmbeddedResource Include="BaseException.resx" />
    <EmbeddedResource Include="BOP\BOPException.resx" DependentUpon="BOPException.cs" />
  </ItemGroup>

</Project>
