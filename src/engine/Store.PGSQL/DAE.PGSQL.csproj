<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Alphora.Dataphor.DAE.PGSQL</AssemblyName>
    <RootNamespace>Alphora.Dataphor.DAE</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!-- Constants: the legacy Release set without SIGNASSEMBLIES (signing is set in Directory.Build.props), which leaves none, in both configurations, plus DEBUG;TRACE in Debug. Set outright; see Directory.Build.props. -->
  <PropertyGroup>
    <DefineConstants></DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <!--
    No driver package of its own: PostgreSQLConnection and PostgreSQLCommand live in the D4 library libraries\PGSQLConnection,
    which owns the Npgsql package, and this store reaches the server through them. That is the one way this store differs in
    shape from the other two, whose connection classes are in Server.csproj - and it is why the runtime layout has to put that
    library's assembly and Npgsql into bin\ as well as into the library's own folder (tools\layout\Layout.csproj says why).
  -->
  <ItemGroup>
    <ProjectReference Include="..\Base\Base.csproj" />
    <ProjectReference Include="..\DAE\DAE.csproj" />
    <ProjectReference Include="..\Server\Server.csproj" />
    <ProjectReference Include="..\..\..\libraries\PGSQLConnection\Source\DAE.Connection.PGSQL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="PGSQLStore.cs" />
    <Compile Include="PGSQLStoreConnection.cs" />
  </ItemGroup>

  <!-- Loaded by name, Alphora.Dataphor.DAE.SystemStoreCatalog.sql (src\engine\DAE\Device.Catalog\CatalogStore.cs). -->
  <ItemGroup>
    <EmbeddedResource Include="SystemStoreCatalog.sql" />
  </ItemGroup>

</Project>
