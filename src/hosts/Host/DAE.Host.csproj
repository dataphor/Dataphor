<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RootNamespace is Alphora.Dataphor.DAE.Service rather than a namespace matching the folder name, for two reasons.
    The types here keep the namespace their callers already use (the service executable and the tray configuration
    utility today, the command-line tool later), and EmbeddedResourceUseDependentUponConvention is off repository-wide,
    so Strings.resx takes the manifest name $(RootNamespace).Strings - the name Strings.cs looks it up by.
  -->
  <PropertyGroup>
    <AssemblyName>Alphora.Dataphor.DAE.Host</AssemblyName>
    <RootNamespace>Alphora.Dataphor.DAE.Service</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!-- Constants: the legacy Release set without SIGNASSEMBLIES (signing is set in Directory.Build.props) in both configurations, plus DEBUG;TRACE in Debug. Set outright; see Directory.Build.props. -->
  <PropertyGroup>
    <DefineConstants>TRACE</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <!-- The hosts DataphorHost runs, and through them the engine, whose DefaultServerName is the instance name the command line defaults to. -->
  <ItemGroup>
    <ProjectReference Include="..\..\engine\Server.Hosting\Server.Hosting.csproj" />
  </ItemGroup>

  <!--
    System.ServiceProcess.ServiceController: ServiceController, ServiceControllerStatus and ServiceStartMode, which
    ServiceUtility reads a service's status and start mode through.
    Microsoft.Extensions.Hosting.WindowsServices: UseWindowsService and WindowsServiceHelpers.IsWindowsService, which is
    the whole of "the same program runs as a Windows service"; it also brings the event-log logging provider.
    CoreWCF.NetTcp and the framework reference: this project references Server.Hosting, which carries both, and a project
    that gets CoreWCF.NetTcp only through a project reference reports the package-audit warning NU1902 for its
    Microsoft.AspNetCore.* 2.3.10 dependencies. Declaring the package here as well lets NuGet's package-override
    mechanism substitute the in-box ASP.NET Core 10 assemblies; Server.Hosting.csproj records the measurement.
  -->
  <ItemGroup>
    <PackageReference Include="CoreWCF.NetTcp" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="DataphorHost.cs" />
    <Compile Include="HostCommandLine.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="ServiceUtility.cs" />
    <Compile Include="Strings.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Strings.resx" />
  </ItemGroup>

</Project>
