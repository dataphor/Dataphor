<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Windows service name of the host program: Service.Main is one line over DataphorHost, which DAEServer.exe also
    runs. This is the binary an existing service registration names, so the file name and the entry-point type name are
    unchanged.
  -->
  <PropertyGroup>
    <AssemblyName>DAEService</AssemblyName>
    <RootNamespace>Alphora.Dataphor.DAE.Service</RootNamespace>
    <OutputType>Exe</OutputType>
    <StartupObject>Alphora.Dataphor.DAE.Service.Service</StartupObject>
    <ApplicationIcon>Dataphor.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Constants: the legacy Release set without SIGNASSEMBLIES (signing is set in Directory.Build.props) in both configurations, plus DEBUG;TRACE in Debug. Set outright; see Directory.Build.props. -->
  <PropertyGroup>
    <DefineConstants>TRACE</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <!--
    Server, non-concurrent garbage collection, which this project's app.config asked for with <gcServer enabled="true"/>
    and <gcConcurrent enabled="false"/>; on .NET these are runtimeconfig.json properties, written from here.
  -->
  <PropertyGroup>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Host\DAE.Host.csproj" />
    <!--
      Not compiled against, and not optional: the server resolves its catalog store from a class name with Type.GetType
      (Server.DefaultCatalogStoreClassName, or the instance's catalogstoreclassname setting), and on .NET 10 an assembly
      that sits next to the executable but is not named in the executable's .deps.json cannot be loaded by simple name -
      there is no app-local probing to fall back on. So every store the runtime layout ships is referenced here, not only
      the default: without the reference the server fails to start on that store with error 115107, and the assembly
      being in the folder does not help. HostProgramTest keeps the two lists together.
    -->
    <ProjectReference Include="..\..\engine\Store.MSSQL\DAE.MSSQL.csproj" />
    <ProjectReference Include="..\..\engine\Store.SQLite\DAE.SQLite.csproj" />
  </ItemGroup>

  <!--
    CoreWCF.NetTcp and the framework reference: this project gets CoreWCF.NetTcp through project references, and a
    project that gets it only that way reports the package-audit warning NU1902 for its Microsoft.AspNetCore.* 2.3.10
    dependencies. Declaring the package here as well lets NuGet's package-override mechanism substitute the in-box
    ASP.NET Core 10 assemblies; Server.Hosting.csproj records the measurement. This program therefore needs the
    ASP.NET Core shared runtime as well as the .NET one, which every .NET install that carries the server has.
  -->
  <ItemGroup>
    <PackageReference Include="CoreWCF.NetTcp" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Service.cs" />
  </ItemGroup>

</Project>
