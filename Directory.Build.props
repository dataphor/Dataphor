<Project>

  <!--
    Settings shared by every SDK-style project under the repository root. Later conversions follow the
    same conventions; AGENTS.md "Build and test" summarizes them. Not set here, by design:

    Compiler constants are set per project, outright rather than appended to $(DefineConstants), so the
    SDK's default TRACE is not added: the legacy Release set without SIGNASSEMBLIES (signing is set below) in both configurations,
    plus DEBUG;TRACE in Debug (DAE.csproj records why). The SDK still appends DEBUG/RELEASE and framework
    symbols such as NET10_0; no converted code tests them.
  -->

  <!-- Framework and language. Windows UI projects override TargetFramework with net10.0-windows. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- Explicit item lists: each project lists its Compile and EmbeddedResource items, copied from the legacy project file, because source files that are not compiled sit next to ones that are. -->
  <PropertyGroup>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <!-- Legacy resource names: a .resx takes the name of the first class in a .cs file only when the item names that file in DependentUpon metadata, as legacy MSBuild did; the SDK convention would rename resources that are looked up by name. -->
  <PropertyGroup>
    <EmbeddedResourceUseDependentUponConvention>false</EmbeddedResourceUseDependentUponConvention>
  </PropertyGroup>

  <!--
    Version and identity (decision D7): one version for every assembly, set here and nowhere else. The SDK
    generates AssemblyVersion 4.0.0.0, AssemblyInformationalVersion 4.0.0-preview+<commit>, AssemblyFileVersion,
    company, product and copyright. Each project's Properties\AssemblyInfo.cs keeps only what differs per project
    or is Dataphor's own: AssemblyTitle, AssemblyDescription, DAERegister (library registration reads it),
    ComVisible, Guid. An attribute left there that the SDK also generates fails the build with CS0579.
  -->
  <PropertyGroup>
    <VersionPrefix>4.0.0</VersionPrefix>
    <VersionSuffix>preview</VersionSuffix>
    <!--
      NOTE: with DataphorBuildNumber left at 0 every build has FileVersion 4.0.0.0, and Windows Installer does not
      replace a file of equal version during a minor upgrade. installer-msi must either pass a build number
      (dotnet build -p:DataphorBuildNumber=<run number>) or schedule RemoveExistingProducts early.
      AssemblyVersion stays 4.0.0.0 whatever the build number.
    -->
    <DataphorBuildNumber Condition="'$(DataphorBuildNumber)' == ''">0</DataphorBuildNumber>
    <FileVersion>$(VersionPrefix).$(DataphorBuildNumber)</FileVersion>
    <Company>Alphora</Company>
    <Product>Dataphor</Product>
    <Copyright>© Copyright 2000-2015 Alphora</Copyright>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
  </PropertyGroup>

  <!-- Deterministic builds: two builds of the same commit produce identical assemblies. CI builds also map source paths. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Strong names in every configuration, with the repository-root key pair. The key is public: a strong name here is identity, not a security boundary. -->
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)Dataphor.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <!-- Output: artifacts/bin/<project file name>/<debug|release>/ and artifacts/obj/; nothing is built into source folders. -->
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <!-- Windows NLS globalization, as on .NET Framework, for every executable and test host (written to its runtimeconfig.json; libraries ignore it): string comparison and culture behaviour must not change under existing applications. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Globalization.UseNls" Value="true" />
  </ItemGroup>

  <!--
    Warning baseline: warnings stay warnings and stay visible. Never suppress CS0618, SYSLIB*, WFDEV*,
    CA1416 or NU1900-NU1904: on .NET 10 several removed APIs compile and then throw at run time.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
